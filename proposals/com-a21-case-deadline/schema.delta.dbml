// Proposed additive delta to operations.case_event_type
// INFORMATION_RESPONSE_DEADLINE_EXPIRED

Table operations.cases_case_deadline_delta {
  case_id uuid [pk, note: 'Conceptually operations.cases.id; shown separately because this is an isolated proposal.']
  response_deadline_at timestamptz
  deadline_policy_version varchar(80)

  checks {
    `(response_deadline_at IS NOT NULL AND deadline_policy_version IS NOT NULL) OR (response_deadline_at IS NULL AND deadline_policy_version IS NULL)` [name: 'case_response_deadline_pair']
  }
}

Table operations.case_deadline_receipts_proposal {
  case_id uuid [not null]
  expected_case_version bigint [not null]
  response_deadline_at timestamptz [not null]
  decision_status varchar(32) [not null]
  case_event_id uuid
  correlation_id uuid [not null]
  decided_at timestamptz [not null]

  indexes {
    (case_id, expected_case_version, response_deadline_at) [pk]
    (case_id, case_event_id) [unique]
  }

  checks {
    `decision_status IN ('APPLIED', 'ALREADY_TRANSITIONED')` [name: 'case_deadline_decision_valid']
    `(decision_status = 'APPLIED' AND case_event_id IS NOT NULL) OR (decision_status = 'ALREADY_TRANSITIONED' AND case_event_id IS NULL)` [name: 'case_deadline_event_consistent']
  }
}
