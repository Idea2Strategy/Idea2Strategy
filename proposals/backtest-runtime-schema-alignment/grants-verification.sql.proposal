-- PROPOSAL-LOCAL POST-MIGRATION VERIFICATION; this file grants no new privilege.
-- Run after R__database_runtime_grants.sql on PostgreSQL 16.

DO $$
DECLARE
  outcome_column text;
BEGIN
  IF (
    SELECT pg_get_userbyid(relowner)
    FROM pg_class
    WHERE oid = 'backtest.runs'::regclass
  ) = 'idea2strategy_backtest' THEN
    RAISE EXCEPTION 'application role idea2strategy_backtest must not own backtest.runs';
  END IF;

  FOREACH outcome_column IN ARRAY ARRAY[
    'result_manifest_id',
    'retryable',
    'missing_requirements'
  ]
  LOOP
    IF NOT has_column_privilege('idea2strategy_backend', 'backtest.runs', outcome_column, 'SELECT')
       OR NOT has_column_privilege('idea2strategy_backend', 'backtest.runs', outcome_column, 'INSERT')
       OR has_column_privilege('idea2strategy_backend', 'backtest.runs', outcome_column, 'UPDATE') THEN
      RAISE EXCEPTION 'backend privilege drift on backtest.runs.%', outcome_column;
    END IF;

    IF NOT has_column_privilege('idea2strategy_batch', 'backtest.runs', outcome_column, 'SELECT')
       OR has_column_privilege('idea2strategy_batch', 'backtest.runs', outcome_column, 'INSERT')
       OR has_column_privilege('idea2strategy_batch', 'backtest.runs', outcome_column, 'UPDATE') THEN
      RAISE EXCEPTION 'batch privilege drift on backtest.runs.%', outcome_column;
    END IF;

    IF NOT has_column_privilege('idea2strategy_backtest', 'backtest.runs', outcome_column, 'SELECT')
       OR NOT has_column_privilege('idea2strategy_backtest', 'backtest.runs', outcome_column, 'INSERT')
       OR NOT has_column_privilege('idea2strategy_backtest', 'backtest.runs', outcome_column, 'UPDATE') THEN
      RAISE EXCEPTION 'backtest privilege drift on backtest.runs.%', outcome_column;
    END IF;
  END LOOP;
END
$$;
