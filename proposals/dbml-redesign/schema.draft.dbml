Table operations.case_events {
  id uuid [pk, default: `gen_random_uuid()`]
  case_id uuid [not null]
  event_sequence int [not null]
  actor_type varchar(30) [not null]
  actor_id uuid [not null]
  event_type varchar(60) [not null]
  payload_document jsonb [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (case_id, event_sequence) [unique]
  }

  Note: 'Stores case events. Records contains fictional documentation-only review data and is never a production seed or migration.'

  Records (id, case_id, event_sequence, actor_type, actor_id, event_type, payload_document, created_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 'REVIEW_EXAMPLE', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '{"example":true}', '2026-07-27T09:00:00+09:00'
  }
}

