    `row_count IS NULL OR row_count > 0` [name: 'feature_snapshot_batch_row_count_positive']
    `status <> 'SUCCEEDED' OR (snapshot_object_id IS NOT NULL AND batch_hash IS NOT NULL AND row_count IS NOT NULL AND available_at IS NOT NULL)` [name: 'feature_snapshot_batch_success_complete']
  }

  Note: 'Metadata for an immutable microbatch of shared live-feature snapshots calculated once and fanned out to all eligible bots. Snapshot bodies are buffered in stream/cache and sealed together into one object, avoiding one PostgreSQL row or one S3 object per tick. Each body row has a batch-local snapshot key and hashes; evaluations store that key and their exact hashes. SUCCEEDED requires object, batch_hash, row_count, and available_at. Cache expiry never deletes authoritative evidence.'

  Records (id, feature_set_hash, input_market_set_hash, source_start_watermark, source_end_watermark, period_start, period_end, snapshot_object_id, batch_hash, row_count, status, idempotency_key, available_at, created_at) {
    '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'REVIEW_EXAMPLE', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, 'SUCCEEDED', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

