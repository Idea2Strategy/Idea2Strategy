Table market_data.feature_materializations {
  id uuid [pk, default: `gen_random_uuid()`]
  feature_definition_id uuid [not null]
  instrument_id uuid [not null]
  pipeline_run_id uuid [not null, unique]
  input_dataset_set_hash varchar(128) [not null]
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  source_watermark varchar(300) [not null]
  output_dataset_manifest_id uuid
  result_hash varchar(128)
  status operations.work_status [not null]
  available_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (feature_definition_id, instrument_id, input_dataset_set_hash, period_start, period_end) [unique]
    (instrument_id, period_end, status)
    (output_dataset_manifest_id) [unique]
  }


  checks {
    `period_end > period_start` [name: 'feature_materialization_period_order']
    `status <> 'SUCCEEDED' OR (output_dataset_manifest_id IS NOT NULL AND result_hash IS NOT NULL AND available_at IS NOT NULL)` [name: 'feature_materialization_success_complete']
  }

  Note: 'One historical shared-calculation result per canonical definition, instrument, exact input set, and period. Large time-series values remain in the DERIVED dataset objects in S3-compatible storage; PostgreSQL stores only identity, status, hashes, watermarks, and the output manifest. The unique computation key and pipeline idempotency prevent duplicate server work.'

  Records (id, feature_definition_id, instrument_id, pipeline_run_id, input_dataset_set_hash, period_start, period_end, source_watermark, output_dataset_manifest_id, result_hash, status, available_at, created_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', 'REVIEW_EXAMPLE', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'SUCCEEDED', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

