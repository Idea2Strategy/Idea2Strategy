// -----------------------------------------------------------------------------
// identity: customer identity and service-owned authentication.
// -----------------------------------------------------------------------------

Table identity.accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  lifecycle_status identity.account_lifecycle_status [not null]
  status_changed_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (lifecycle_status, created_at)
  }

  Note: 'Minimal account root. Preferences, email, authentication, consent, and sanctions are separate aggregates. Account creation inserts its email and preferences in the same transaction; activation requires the single email to be VERIFIED. Sanctions do not overload lifecycle_status.'

  Records (id, lifecycle_status, status_changed_at, created_at) {
    '00000000-0000-4000-8000-000000000001', 'ACTIVE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table identity.account_lifecycle_events {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  event_sequence bigint [not null]
  previous_status identity.account_lifecycle_status
  new_status identity.account_lifecycle_status [not null]
  reason_code varchar(80)
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, event_sequence) [unique]
    (account_id, occurred_at)
  }

  Note: 'Append-only lifecycle evidence. accounts.lifecycle_status is the transactionally maintained current projection.'

  Records (id, account_id, event_sequence, previous_status, new_status, reason_code, occurred_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, null, 'ACTIVE', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00'
  }
}

Table identity.account_preferences {
  account_id uuid [pk]
  language_code varchar(12) [not null, note: 'Current supported values are ko and en.']
  timezone_name varchar(80) [not null, note: 'IANA time-zone name used for display only; market calculations use exchange calendars.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Created atomically with the account. Notification opt-ins remain in operations.notification_preferences and legal marketing consent remains in account_consents.'

  Records (account_id, language_code, timezone_name, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', 'ko', 'America/New_York', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table identity.account_emails {
  account_id uuid [pk]
  email_ciphertext text [not null]
  email_lookup_hmac varchar(128) [not null, unique]
  email_lookup_key_version smallint [not null]
  encryption_key_version smallint [not null]
  status identity.email_status [not null]
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz

  indexes {
    (status, created_at)
  }

  Note: 'Shared primary key enforces at most one email row per account. A deferred lifecycle guard requires every activatable account to own this row and requires VERIFIED before activation. The application normalizes before keyed lookup, stores no plaintext index, and must define whether a revoked email may later be reused.'

  Records (account_id, email_ciphertext, email_lookup_hmac, email_lookup_key_version, encryption_key_version, status, verified_at, created_at, revoked_at) {
    '00000000-0000-4000-8000-000000000001', 'encrypted-user@example.test', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, 1, 'VERIFIED', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', null
  }
}

Table identity.email_verification_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  token_digest varchar(128) [not null, unique]
  digest_key_version smallint [not null]
  requested_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  revoked_at timestamptz
  failed_attempt_count int [not null, default: 0]
  request_ip_prefix inet

  indexes {
    (account_id, requested_at)
    (expires_at, consumed_at)
  }

  Note: 'Append-only verification attempts. Issuing a newer request may revoke an older active request; verification and consumption are atomic.'

  Records (id, account_id, token_digest, digest_key_version, requested_at, expires_at, consumed_at, revoked_at, failed_attempt_count, request_ip_prefix) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', null, null, 1, '203.0.113.0/24'
  }
}

Table identity.auth_providers {
  id smallint [pk]
  code varchar(40) [not null, unique]
  display_name varchar(80) [not null]
  provider_type identity.auth_provider_type [not null]
  issuer text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Seeded provider catalog. PASSWORD has no issuer; OIDC providers require an exact issuer and immutable subject validation.'

  Records (id, code, display_name, provider_type, issuer, is_active, created_at, updated_at) {
    1, 'REVIEW_EXAMPLE', 'Review Example', 'PASSWORD', 'review-example', true, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table identity.login_identities {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  provider_id smallint [not null]
  provider_subject_hmac varchar(128)
  subject_key_version smallint
  linked_at timestamptz [not null, default: `now()`]
  last_authenticated_at timestamptz
  disabled_at timestamptz
  disabled_reason_code varchar(80)

  indexes {
    (provider_id, provider_subject_hmac) [unique]
    (account_id, provider_id) [unique]
    (account_id, id) [unique]
  }

  Note: 'PASSWORD uses the single verified account email and requires a null provider subject. OIDC requires a keyed immutable subject. Provider email never auto-links accounts.'

  Records (id, account_id, provider_id, provider_subject_hmac, subject_key_version, linked_at, last_authenticated_at, disabled_at, disabled_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE'
  }
}

Table identity.password_credentials {
  login_identity_id uuid [pk]
  password_hash text [not null]
  hash_scheme varchar(40) [not null]
  hash_parameters jsonb [not null]
  credential_version bigint [not null, default: 1]
  password_changed_at timestamptz [not null]
  compromised_at timestamptz

  Note: 'Allowed only for a PASSWORD login identity. Password change increments credential_version and revokes affected sessions in the same workflow.'

  Records (login_identity_id, password_hash, hash_scheme, hash_parameters, credential_version, password_changed_at, compromised_at) {
    '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'REVIEW_EXAMPLE', '{"example":true}', 1, '2026-07-27T09:00:00+09:00', null
  }
}

Table identity.sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  authenticated_by_login_identity_id uuid [not null]
  token_digest varchar(128) [not null, unique]
  digest_key_version smallint [not null]
  device_label varchar(120)
  issued_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null]
  expires_at timestamptz [not null]
  reauthenticated_at timestamptz
  revoked_at timestamptz
  revoke_reason_code varchar(80)

  indexes {
    (account_id, expires_at)
    (account_id, revoked_at)
  }

  Note: 'Server-owned opaque session. PostgreSQL owns issuance and revocation; caches may accelerate lookup but may not authorize a revoked session.'

  Records (id, account_id, authenticated_by_login_identity_id, token_digest, digest_key_version, device_label, issued_at, last_seen_at, expires_at, reauthenticated_at, revoked_at, revoke_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, 'review-example', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', '2026-07-27T09:00:00+09:00', null, 'REVIEW_EXAMPLE'
  }
}

Table identity.password_reset_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  login_identity_id uuid [not null]
  token_digest varchar(128) [not null, unique]
  digest_key_version smallint [not null]
  requested_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  revoked_at timestamptz
  failed_attempt_count int [not null, default: 0]
  request_ip_prefix inet

  indexes {
    (account_id, requested_at)
    (login_identity_id, consumed_at)
    (expires_at, consumed_at)
  }

  Note: 'The account has one email, so the request binds account and PASSWORD identity. Token verification, password replacement, request consumption, and session revocation are atomic.'

  Records (id, account_id, login_identity_id, token_digest, digest_key_version, requested_at, expires_at, consumed_at, revoked_at, failed_attempt_count, request_ip_prefix) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', null, null, 1, '203.0.113.0/24'
  }
}

Table identity.recovery_code_sets {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  purpose varchar(40) [not null, note: 'ACCOUNT_RECOVERY in the current product.']
  issued_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  revoke_reason_code varchar(80)

  indexes {
    (account_id, purpose, issued_at)
  }

  Note: 'Only one active set per account and purpose is permitted by a partial unique index in the migration.'

  Records (id, account_id, purpose, issued_at, revoked_at, revoke_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', null, 'REVIEW_EXAMPLE'
  }
}

Table identity.recovery_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  recovery_code_set_id uuid [not null]
  code_digest varchar(128) [not null, unique]
  digest_key_version smallint [not null]
  used_at timestamptz

  indexes {
    (recovery_code_set_id, used_at)
  }

  Note: 'Stores recovery codes. Records contains fictional documentation-only review data and is never a production seed or migration.'

  Records (id, recovery_code_set_id, code_digest, digest_key_version, used_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00'
  }
}

Table identity.policy_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  policy_code varchar(80) [not null]
  version varchar(40) [not null]
  language_code varchar(12) [not null]
  title varchar(160) [not null]
  content_format varchar(20) [not null]
  content_text text [not null]
  content_hash varchar(128) [not null]
  is_required boolean [not null, default: true]
  published_at timestamptz [not null]
  retired_at timestamptz

  indexes {
    (policy_code, version, language_code) [unique]
    (is_required, published_at)
  }

  Note: 'Policy text is small immutable relational content. Large evidence attachments, if introduced, use storage.objects rather than replacing this authoritative text.'

  Records (id, policy_code, version, language_code, title, content_format, content_text, content_hash, is_required, published_at, retired_at) {
    '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '1.0.0', 'ko', 'Review Example', 'REVIEW_EXAMPLE', 'Fictional review content', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', true, '2026-07-27T09:00:00+09:00', null
  }
}

Table identity.account_consents {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  policy_document_id uuid [not null]
  decision identity.consent_decision [not null]
  supersedes_consent_id uuid [unique]
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, policy_document_id, recorded_at)
  }

  Note: 'Append-only decision history. Withdrawal and later re-acceptance create new rows instead of mutating prior legal evidence.'

  Records (id, account_id, policy_document_id, decision, supersedes_consent_id, recorded_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'ACCEPTED', '00000000-0000-4000-8000-000000000001', '2026-07-27T09:00:00+09:00'
  }
}

