  }
}

Table trading.order_intent_batches {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  source_event_id uuid [not null]
  status varchar(30) [not null]
  conflict_policy_hash varchar(128) [not null]
  allocation_rules_version varchar(40) [not null]
  input_state_hash varchar(128) [not null]
  result_hash varchar(128)
  finalized_at timestamptz

  indexes {
    (bot_id, source_event_id) [unique]
    (bot_id, finalized_at)
  }

  Note: '한 트리거 이벤트의 Flow별 평가 산출물이 결합되는 봇 수준 경계: 예산 상한, netting, 불변 충돌 정책이 여기서 bot_id advisory lock 아래 같은 봇의 다른 이벤트와 직렬화되어 적용. (bot_id, source_event_id) 유일 키가 at-least-once 재전달의 중복 배치 생성을 방지.'

  Records (id, bot_id, source_event_id, status, conflict_policy_hash, allocation_rules_version, input_state_hash, result_hash, finalized_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'ACTIVE', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '2026-07-27T09:00:00+09:00'
  }
}

