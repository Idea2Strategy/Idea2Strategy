// -----------------------------------------------------------------------------
// bot: editable workspace plus immutable execution aggregate.
// -----------------------------------------------------------------------------

Table bot.bot_workspaces {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_account_id uuid [not null]
  mode strategy.strategy_mode [not null]
  name varchar(120) [not null]
  workspace_document jsonb [not null]
  document_schema_version varchar(40) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_account_id, updated_at)
  }

  Note: 'Autosaved incomplete editor aggregate. Empty partitions and incomplete strategies are allowed only here. Completion validates the whole document and creates a new independent bot hierarchy atomically; no workspace, source-copy, version, or lineage reference is retained by the completed bot. edit_sequence is used for optimistic concurrency.'

  Records (id, owner_account_id, mode, name, workspace_document, document_schema_version, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'BASIC', 'Review Example', '{"example":true}', '1.0.0', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.bots {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_account_id uuid [not null]
  mode strategy.strategy_mode [not null]
  name varchar(120) [not null]
  lifecycle_status bot.lifecycle_status [not null]
  health_status bot.health_status [not null]
  lifecycle_changed_at timestamptz [not null]
  health_changed_at timestamptz [not null]
  health_reason_code varchar(80)
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz [not null]
  stop_requested_at timestamptz
  stopped_at timestamptz
  stop_reason_code varchar(80)
  archived_at timestamptz
  deleted_at timestamptz
  edit_sequence bigint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_account_id, lifecycle_status, created_at)
    (lifecycle_status, health_status, created_at)
    (owner_account_id, deleted_at, archived_at, created_at)
  }

  Note: 'Created directly in RUNNING/HEALTHY only after the aggregate has at least one partition, every partition has at least one complete strategy, and launch validation succeeds. Lifecycle is RUNNING -> STOPPING -> STOPPED; STOPPED is permanent. Non-HEALTHY blocks new evaluations and orders but existing order cancellation, fills, reservation release, and settlement continue; recovery returns health to HEALTHY without a PAUSED state. mode and execution meaning are immutable. name, archived_at, and deleted_at are mutable fields excluded from configuration hashes. archived_at reversibly hides a STOPPED bot; deleted_at is an irreversible user-visible logical deletion and may be set directly without prior archive, but only after the bot reaches STOPPED and settlement completes. A delete request for a running bot first initiates the idempotent stop and settlement workflow. Physical purge is a separate retention/legal process and must not cascade-delete official orders, fills, ledgers, events, or evidence. edit_sequence starts at 0 and increments exactly once per successful editable-field update for optimistic concurrency; updated_at records that commit time. A copy is an independent new aggregate with new identifiers and no source lineage; runtime cash, state, orders, positions, ledgers, competition participation, and performance are never copied. Production migrations should use partial indexes for active lists where deleted_at IS NULL and archived_at IS NULL.'

  Records (id, owner_account_id, mode, name, lifecycle_status, health_status, lifecycle_changed_at, health_changed_at, health_reason_code, created_at, started_at, stop_requested_at, stopped_at, stop_reason_code, archived_at, deleted_at, edit_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'BASIC', 'Review Example', 'RUNNING', 'HEALTHY', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', null, null, 'REVIEW_EXAMPLE', null, null, 1, '2026-07-27T09:00:00+09:00'
  }
}

Table bot.launch_configurations {
  bot_id uuid [pk]
  initial_cash_amount numeric(24,8) [not null]
  currency_code char(3) [not null, default: 'USD']
  broker_rules_version varchar(80) [not null]
  accounting_rules_version varchar(80) [not null]
  precision_rules_version varchar(80) [not null]
  fee_configuration jsonb [not null]
  slippage_rate_bps int [not null, note: 'Fixed 5 bps; + for buys and - for sells.']
  buying_power_buffer_policy_id uuid [not null]
  candidate_conflict_policy jsonb [not null]
  configuration_hash varchar(128) [not null]

  checks {
    `initial_cash_amount > 0` [name: 'launch_initial_cash_positive']
    `slippage_rate_bps = 5` [name: 'launch_fixed_slippage_five_bps']
  }

  Note: 'Inserted atomically with the bot, partitions, and completed strategies. Initial virtual capital is positive, USD-denominated, isolated per bot, and cannot be deposited, withdrawn, or increased. User-defined risk controls live only in strategy RISK_POLICY blocks. Execution configuration is immutable from creation; semantic updates and deletes are always rejected.'

  Records (bot_id, initial_cash_amount, currency_code, broker_rules_version, accounting_rules_version, precision_rules_version, fee_configuration, slippage_rate_bps, buying_power_buffer_policy_id, candidate_conflict_policy, configuration_hash) {
    '00000000-0000-4000-8000-000000000001', 100000.00000000, 'USD', '1.0.0', '1.0.0', '1.0.0', '{"example":true}', 5, '00000000-0000-4000-8000-000000000001', '{"example":true}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  }
}

Table bot.bot_partitions {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  name varchar(120) [not null]
  description text
  budget_cap_bps int [not null, note: '0..10000 of bot initial capital. Sibling sum must be <=10000.']
  position_x numeric(14,4) [not null]
  position_y numeric(14,4) [not null]
  configuration_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bot_id, position_y, position_x, id)
    (bot_id, id) [unique]
  }


  checks {
    `budget_cap_bps > 0 AND budget_cap_bps <= 10000` [name: 'partition_budget_cap_range']
  }

  Note: 'A completed partition owns an immutable positive budget cap of at most 100% and at least one strategy block group; sibling caps are validated with a deferred aggregate constraint so their sum is at most 100%. It does not own instruments or a separate risk-policy document. The partition is the lowest budget boundary, so all child strategies share this cap and receive no individual allocation. Risk controls are RISK_POLICY blocks in each strategy semantic_document. No borrowing across sibling partitions. name, description, position_x, and position_y are editable fields excluded from configuration_hash; coordinates may overlap, and id is only a deterministic query tie-breaker. edit_sequence starts at 0 and increments exactly once per successful editable-field update for optimistic concurrency; updated_at records that commit time. (bot_id, id) is an alternate ownership key, not a composite primary key or version. Copy/paste creates a new independent row and children with no source reference.'

  Records (id, bot_id, name, description, budget_cap_bps, position_x, position_y, configuration_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'Review Example', 'Fictional review sample', 5000, 100000.00000000, 100000.00000000, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.strategies {
  id uuid [pk, default: `gen_random_uuid()`]
  partition_id uuid [not null]
  name varchar(120) [not null]
  description text
  block_catalog_version_id uuid [not null]
  execution_plan_id uuid [not null]
  position_x numeric(14,4) [not null]
  position_y numeric(14,4) [not null]
  semantic_document jsonb [not null]
  semantic_hash varchar(128) [not null]
  configuration_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (partition_id, position_y, position_x, id)
    (partition_id, id) [unique]
    (semantic_hash)
  }

  Note: 'A strategy is a complete block-group aggregate owned by exactly one partition, not a reusable library item or a versioned entity. It inherits the single BASIC/PRO mode from its bot. The partition is the only budget-allocation boundary; strategy_id on runtime rows records attribution only. name, description, position_x, and position_y are editable fields excluded from semantic_hash and configuration_hash; coordinates may overlap, and id is only a deterministic query tie-breaker. edit_sequence starts at 0 and increments exactly once per successful editable-field update for optimistic concurrency; updated_at records that commit time. Blocks, ports, edges, parameters, semantic groups, and RISK_POLICY blocks are one immutable semantic JSONB aggregate. Per-block coordinates, sizes, viewport, zoom, selection, folding, and other UI layout state are not persisted; clients derive block placement deterministically from the semantic graph and may evolve their renderer independently. configuration_hash binds the block catalog version and semantic_hash only. (partition_id, id) is an alternate ownership key for composite runtime FKs. Copy/paste creates an independent new row with no source reference.'

  Records (id, partition_id, name, description, block_catalog_version_id, execution_plan_id, position_x, position_y, semantic_document, semantic_hash, configuration_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'Review Example', 'Fictional review sample', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 100000.00000000, 100000.00000000, '{"example":true}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.strategy_instruments {
  strategy_id uuid [not null]
  instrument_id uuid [not null]

  indexes {
    (strategy_id, instrument_id) [pk]
  }

  Note: 'Immutable set of explicit instruments required by the completed strategy semantic_document. Whether an instrument is traded or used as a reference is defined once by typed blocks and edges in that document, not duplicated as a mutable role here. Inserted atomically with the strategy; launch validation requires at least one instrument and exact equality between extracted dependencies and these rows. Future universe selection is out of current scope and must be introduced through a separately reviewed model and migration when the product supports it.'

  Records (strategy_id, instrument_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.strategy_feature_requirements {
  strategy_id uuid [not null]
  instrument_id uuid [not null]
  feature_definition_id uuid [not null]

  indexes {
    (strategy_id, instrument_id, feature_definition_id) [pk]
    (feature_definition_id, instrument_id, strategy_id)
  }

  Note: 'Immutable dependency set extracted from the strategy semantic_document at completion. It is not user-authored state and grants no budget. The reverse index lets the server group all active strategies by identical feature and instrument so a common calculation is performed once and fanned out to many bot evaluations.'

  Records (strategy_id, instrument_id, feature_definition_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.bot_events {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  event_sequence bigint [not null]
  event_type varchar(80) [not null]
  event_schema_version varchar(40) [not null]
  causation_event_id uuid
  correlation_id uuid [not null]
  idempotency_key varchar(160) [not null]
  occurred_at timestamptz [not null]
  received_at timestamptz [not null]
  committed_at timestamptz [not null, default: `now()`]
  summary_document jsonb [not null]
  market_dataset_manifest_id uuid
  evidence_object_id uuid

  indexes {
    (bot_id, event_sequence) [unique]
    (bot_id, id) [unique]
    (bot_id, idempotency_key) [unique]
    (event_type, committed_at)
    (correlation_id)
  }

  Note: 'Append-only ordered official stream per bot. event_sequence is runtime audit ordering, not a bot version; gaps are allowed. Exact market observations used for decisions are pinned by value/version/hash.'

  Records (id, bot_id, event_sequence, event_type, event_schema_version, causation_event_id, correlation_id, idempotency_key, occurred_at, received_at, committed_at, summary_document, market_dataset_manifest_id, evidence_object_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 'REVIEW_EXAMPLE', '1.0.0', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '{"example":true}', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.evaluation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  trigger_event_id uuid [not null, unique]
  result_event_id uuid [unique]
  feature_snapshot_batch_id uuid [not null]
  feature_snapshot_key varchar(200) [not null]
  feature_snapshot_hash varchar(128) [not null]
  status operations.work_status [not null]
  input_state_hash varchar(128) [not null]
  input_market_hash varchar(128) [not null, note: 'Must equal the referenced shared feature snapshot input hash.']
  conflict_policy_hash varchar(128) [not null]
  candidate_set_hash varchar(128)
  started_at timestamptz [not null]
  completed_at timestamptz
  failure_code varchar(80)

  indexes {
    (bot_id, id) [unique]
    (bot_id, started_at)
    (feature_snapshot_batch_id, feature_snapshot_key)
  }


  Note: 'A bot-specific evaluation consumes one immutable shared feature snapshot addressed by batch, key, and hash, then applies only private strategy state, risk blocks, budget, conflict resolution, and order-intent generation. input_market_hash and feature_snapshot_hash are tamper-evident evidence validated against the batched object row; common indicators are never recalculated per bot.'

  Records (id, bot_id, trigger_event_id, result_event_id, feature_snapshot_batch_id, feature_snapshot_key, feature_snapshot_hash, status, input_state_hash, input_market_hash, conflict_policy_hash, candidate_set_hash, started_at, completed_at, failure_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'SUCCEEDED', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE'
  }
}

Table bot.evaluation_strategy_results {
  evaluation_run_id uuid [not null]
  bot_id uuid [not null]
  partition_id uuid [not null]
  strategy_id uuid [not null]
  status operations.work_status [not null]
  candidate_count int [not null]
  state_change_count int [not null]
  result_hash varchar(128) [not null]
  failure_code varchar(80)
  summary_document jsonb [not null]

  indexes {
    (evaluation_run_id, strategy_id) [pk]
  }

  Note: 'Per-strategy result within one bot evaluation. Composite ownership FKs prevent a result from naming a strategy in another bot or partition; aggregate candidate conflict resolution remains on the evaluation and order-intent batch boundary.'

  Records (evaluation_run_id, bot_id, partition_id, strategy_id, status, candidate_count, state_change_count, result_hash, failure_code, summary_document) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'SUCCEEDED', 1, 1, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'REVIEW_EXAMPLE', '{"example":true}'
  }
}

Table bot.runtime_state_values {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  strategy_id uuid [not null]
  instrument_id uuid
  block_instance_key varchar(160) [not null]
  state_definition_key varchar(160) [not null]
  value_type bot.runtime_value_type [not null]
  current_value jsonb [not null]
  last_event_sequence bigint [not null]
  updated_at timestamptz [not null]

  indexes {
    (bot_id, id) [unique]
    (bot_id, partition_id, strategy_id, block_instance_key, state_definition_key, instrument_id) [unique]
    (bot_id, last_event_sequence)
  }

  Note: 'PostgreSQL owns only official bot-specific strategy state required across evaluations. Explicit bot/partition/strategy ownership prevents cross-bot leakage; instrument_id is nullable only for strategy-wide state. Shared prices, candles, indicators, calendars, or feature values are forbidden here and belong to market_data shared computation or disposable caches. Null-safe uniqueness for instrument_id is enforced in migration.'

  Records (id, bot_id, partition_id, strategy_id, instrument_id, block_instance_key, state_definition_key, value_type, current_value, last_event_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'REVIEW_EXAMPLE', 'DECIMAL', '{"example":true}', 1, '2026-07-27T09:00:00+09:00'
  }
}

Table bot.runtime_state_changes {
  bot_id uuid [not null]
  bot_event_id uuid [not null]
  runtime_state_value_id uuid [not null]
  previous_value_hash varchar(128) [note: 'Null only when the state key is created for the first time.']
  new_value jsonb [not null]
  new_value_hash varchar(128) [not null]
  change_reason_code varchar(80) [not null]

  indexes {
    (bot_event_id, runtime_state_value_id) [pk]
  }

  Note: 'Append-only before/after evidence for bot-specific state changes. bot_id participates in both composite references so an event cannot mutate a state row owned by another bot.'

  Records (bot_id, bot_event_id, runtime_state_value_id, previous_value_hash, new_value, new_value_hash, change_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, '{"example":true}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'REVIEW_EXAMPLE'
  }
}

