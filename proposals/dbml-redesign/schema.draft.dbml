Table market_data.stream_watermarks {
  feed_id uuid [pk]
  last_source_event_at timestamptz [not null]
  last_ingested_at timestamptz [not null]
  last_sequence bigint
  updated_at timestamptz [not null]

  Note: '재구축 가능한 시장 데이터 신선도 Projection(market_data 소유, 실시간 피드당 1행). 평가 전 실행 게이트가 quality_incidents와 함께 읽어 시장 데이터 평가 진행 여부를 결정. 전역 지연·장애는 여기와 operations 관측성에만 존재하며 봇 행을 대량 갱신하지 않는다. 컨슈머 lag, 유실 이벤트, outbox 적체는 같은 파이프라인 범위 문제이고 봇은 자신의 execution_blocked_at만 가진다.'

  Records (feed_id, last_source_event_at, last_ingested_at, last_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 1, '2026-07-27T09:00:00+09:00'
  }
}

// -----------------------------------------------------------------------------
// bot: editable workspace plus immutable execution aggregate.
// -----------------------------------------------------------------------------

Table bot.bot_workspaces {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_account_id uuid [not null]
  strategy_id uuid [not null]
  mode strategy.strategy_mode [not null]
  name varchar(120) [not null]
  workspace_document jsonb [not null, note: '편집 중 파티션·Flow의 semanticDocument와 layoutDocument를 함께 포함한다. 완성 전에는 누락·미연결 Element를 허용하지만 document_schema_version에 맞게 파싱 가능해야 한다.']
  document_schema_version varchar(40) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (strategy_id, updated_at)
    (owner_account_id, updated_at)
  }

  Note: '자동 저장되는 미완성 편집 집합체. 빈 파티션과 미완성 Flow는 여기서만 허용. workspace_document는 각 Flow의 실행 의미 그래프와 UI 레이아웃 그래프를 분리해 포함하며 같은 안정 Element·엣지 키를 사용한다. 완성은 문서 전체의 JSON Schema, 키 참조, 포트 타입, DAG, 레이아웃 수치와 필수 최종 주문 처리 경로를 검증해 새 독립 봇 계층을 원자적으로 생성한다. 완성된 봇은 워크스페이스·원본 복사·버전·계보 참조를 남기지 않는다. edit_sequence는 낙관적 동시성 제어용.'

  Records (id, owner_account_id, strategy_id, mode, name, workspace_document, document_schema_version, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'BASIC', 'Review Example', '{"partitions":[{"name":"SPY 반등","budgetCapBps":5000,"flows":[{"name":"RSI 과매도 진입","complete":false,"semanticDocument":{"elements":[],"edges":[]},"layoutDocument":{"schemaVersion":"1.0.0","elements":{},"edgeRoutes":{},"groups":{},"viewport":{"x":0,"y":0,"zoom":1.0},"selectedElementKeys":[]}}]}]}', '1.0.0', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.bots {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_account_id uuid [not null]
  strategy_id uuid [not null]
  mode strategy.strategy_mode [not null]
  name varchar(120) [not null]
  lifecycle_status bot.lifecycle_status [not null]
  lifecycle_changed_at timestamptz [not null]
  execution_blocked_at timestamptz [note: 'nullable 실행 차단 Projection. NULL이면 정상. 이 봇에만 국한된 손상(런타임 상태 손상, 이벤트 시퀀스 갭, 예약·원장 불일치, 정산 실패, 복구 불가 Element 평가 오류)에서만 설정.']
  execution_block_reason_code varchar(80)
  execution_block_event_id uuid
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz [not null]
  stop_requested_at timestamptz
  stopped_at timestamptz
  stop_reason_code varchar(80)
  archived_at timestamptz
  deleted_at timestamptz
  edit_sequence bigint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (strategy_id, created_at)
    (owner_account_id, lifecycle_status, created_at)
    (lifecycle_status, execution_blocked_at, created_at)
    (owner_account_id, deleted_at, archived_at, created_at)
  }

  checks {
    `execution_blocked_at IS NOT NULL OR (execution_block_reason_code IS NULL AND execution_block_event_id IS NULL)` [name: 'bot_block_fields_together']
  }

  Note: '봇은 정확히 하나의 Strategy에 속하는 불변 시작 설정과 복구 가능한 런타임 데이터이며 상주 프로세스·컨테이너·스레드가 아니다. 상시 실행은 공용 서비스뿐. RUNNING은 새 트리거 평가 대상, STOPPING은 신규 등록을 막고 취소/체결/해제/정산을 마무리, STOPPED는 영구. 봇별 헬스 상태·하트비트는 없다: 전역 시장 데이터·파이프라인 문제는 market_data(stream_watermarks, quality_incidents)와 operations 소유이고 평가 전 실행 게이트가 참조하며 봇 행을 대량 갱신하지 않는다. execution_blocked_at은 봇별 nullable 차단 Projection. 차단 중에는 새 Flow 평가와 새 주문 의도 생성만 멈추고 미체결 주문 취소, 체결 반영, 예약 해제, 원장 기록, 정산, STOPPING 처리는 계속된다. 차단·해제는 추가 전용 공식 bot_events(BOT_EXECUTION_BLOCKED, BOT_EXECUTION_UNBLOCKED, SETTLEMENT_FAILED, LEDGER_INVARIANT_VIOLATED, STATE_REBUILD_COMPLETED)이며 execution_block_event_id가 차단 이벤트를 고정. 파티션 1개 이상, 각 파티션에 완성 Flow 1개 이상, 시작 검증 통과 후에만 RUNNING으로 직접 생성. mode는 부모 Strategy와 일치하고 실행 의미는 불변. name, archived_at, deleted_at은 설정 해시에서 제외되는 가변 필드. archived_at은 STOPPED 봇의 가역 숨김, deleted_at은 STOPPED와 정산 완료 후에만 허용되는 비가역 논리 삭제이며, 실행 중 봇 삭제는 멱등 정지-정산 워크플로를 먼저 수행. 물리 퍼지는 별도 보존·법무 프로세스이고 공식 주문·체결·원장·이벤트·증적을 연쇄 삭제하지 않는다. edit_sequence는 편집 필드 갱신 성공마다 1 증가(낙관적 동시성). 복사는 원본 계보 없는 독립 새 집합체이며 런타임 현금·상태·주문·포지션·원장·참가·성과를 복사하지 않는다. 운영 마이그레이션은 deleted_at IS NULL AND archived_at IS NULL 활성 목록과 execution_blocked_at IS NOT NULL 차단 봇에 partial index 권장.'

  Records (id, owner_account_id, strategy_id, mode, name, lifecycle_status, lifecycle_changed_at, execution_blocked_at, execution_block_reason_code, execution_block_event_id, created_at, started_at, stop_requested_at, stopped_at, stop_reason_code, archived_at, deleted_at, edit_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'BASIC', 'Review Example', 'RUNNING', '2026-07-27T09:00:00+09:00', null, null, null, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', null, null, 'REVIEW_EXAMPLE', null, null, 1, '2026-07-27T09:00:00+09:00'
  }
}

Table bot.launch_configurations {
  bot_id uuid [pk]
  initial_cash_amount numeric(24,8) [not null]
  currency_code char(3) [not null, default: 'USD']
  broker_rules_version varchar(80) [not null]
  accounting_rules_version varchar(80) [not null]
  precision_rules_version varchar(80) [not null]
  fee_configuration jsonb [not null]
  slippage_rate_bps int [not null, note: '고정 5 bps. 매수는 +, 매도는 -.']
  buying_power_buffer_policy_id uuid [not null]
  candidate_conflict_policy jsonb [not null]
  configuration_hash varchar(128) [not null]

  checks {
    `initial_cash_amount > 0` [name: 'launch_initial_cash_positive']
    `slippage_rate_bps = 5` [name: 'launch_fixed_slippage_five_bps']
  }

  Note: '봇·파티션·완성 Flow와 원자적으로 삽입. 초기 가상 자본은 양수 USD, 봇별 격리이며 입금·출금·증액 불가. 사용자 정의 위험 통제는 Flow의 RISK_POLICY Element에만 존재. 실행 설정은 생성 시점부터 불변이며 의미 변경·삭제는 항상 거부.'

  Records (bot_id, initial_cash_amount, currency_code, broker_rules_version, accounting_rules_version, precision_rules_version, fee_configuration, slippage_rate_bps, buying_power_buffer_policy_id, candidate_conflict_policy, configuration_hash) {
    '00000000-0000-4000-8000-000000000001', 100000.00000000, 'USD', '1.0.0', '1.0.0', '1.0.0', '{"type":"RATE_BPS","rateBps":20,"minimumFee":"0"}', 5, '00000000-0000-4000-8000-000000000001', '{"sameInstrumentOpposite":"NET","tieBreaker":"PARTITION_POSITION","budgetOverflow":"REDUCE"}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  }
}

Table bot.bot_partitions {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  name varchar(120) [not null]
  description text
  budget_cap_bps int [not null, note: '봇 초기 자본의 0..10000 bps. 형제 합은 10000 이하.']
  position_x numeric(14,4) [not null]
  position_y numeric(14,4) [not null]
  configuration_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bot_id, position_y, position_x, id)
    (bot_id, id) [unique]
  }


  checks {
    `budget_cap_bps > 0 AND budget_cap_bps <= 10000` [name: 'partition_budget_cap_range']
  }

  Note: '완성된 파티션은 최대 100%의 불변 양수 예산 상한과 1개 이상의 Flow를 소유하며, 형제 상한 합은 지연 집계 제약으로 100% 이하 검증. 종목이나 별도 위험 정책 문서는 소유하지 않는다. 파티션이 최하위 예산 경계라 자식 Flow들은 이 상한을 공유하고 개별 할당은 없다. 위험 통제는 각 Flow semantic_document의 RISK_POLICY Element. 형제 파티션 간 차입 금지. name, description, position_x, position_y는 configuration_hash에서 제외되는 편집 필드이고 좌표 겹침 허용, id는 결정적 조회 타이브레이커. edit_sequence는 0에서 시작해 편집 필드 갱신 성공마다 정확히 1 증가(낙관적 동시성), updated_at은 그 커밋 시각. (bot_id, id)는 복합 PK나 버전이 아닌 대체 소유 키. 복사/붙여넣기는 원본 참조 없는 독립 새 행과 자식을 생성.'

  Records (id, bot_id, name, description, budget_cap_bps, position_x, position_y, configuration_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'Review Example', 'Fictional review sample', 5000, 100000.00000000, 100000.00000000, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.flows {
  id uuid [pk, default: `gen_random_uuid()`]
  partition_id uuid [not null]
  name varchar(120) [not null]
  description text
  element_catalog_version_id uuid [not null]
  compiled_flow_plan_id uuid [not null]
  position_x numeric(14,4) [not null]
  position_y numeric(14,4) [not null]
  semantic_document jsonb [not null]
  layout_document jsonb [not null, note: '요소별 좌표·크기, 그룹 배치·접힘, 선택 상태, edge routing hint, viewport와 zoom을 저장하는 UI 전용 문서. 요소 키와 엣지 키는 semantic_document의 안정 식별자를 참조해야 한다.']
  layout_schema_version varchar(40) [not null]
  semantic_hash varchar(128) [not null]
  layout_hash varchar(128) [not null]
  configuration_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (partition_id, position_y, position_x, id)
    (partition_id, id) [unique]
    (semantic_hash)
  }

  Note: 'Flow는 정확히 하나의 파티션이 소유하는 완결 Element 그래프이며 재사용 라이브러리 항목이나 버전 엔티티가 아니다. BASIC/PRO 모드는 봇에서 상속. 예산 할당 경계는 파티션뿐이고 런타임 행의 flow_id는 귀속 기록용. name, description, position_x, position_y, layout_document와 layout_schema_version은 semantic_hash·configuration_hash에서 제외되는 편집 필드, 좌표 겹침 허용, id는 결정적 조회 타이브레이커. edit_sequence는 0에서 시작해 이름·설명·좌표·레이아웃 같은 편집 필드 갱신 성공마다 정확히 1 증가, updated_at은 그 커밋 시각. Element·포트·안정 키를 가진 엣지·매개변수·의미 그룹·RISK_POLICY Element는 semantic_document 하나의 불변 실행 의미 JSONB 집합체다. layout_document는 같은 안정 Element·엣지 키를 참조하는 UI 전용 JSONB이며 layout_schema_version으로 해석 규칙을 선택하고 layout_hash로 무결성을 확인한다. 레이아웃 변경은 실행 계획, 의미 검증, 백테스트 또는 configuration_hash를 변경하지 않는다. configuration_hash는 Element 카탈로그 버전과 semantic_hash만 바인딩. (partition_id, id)는 복합 런타임 FK용 대체 소유 키. 복사/붙여넣기는 원본 참조 없는 독립 새 행 생성.'

  Records (id, partition_id, name, description, element_catalog_version_id, compiled_flow_plan_id, position_x, position_y, semantic_document, layout_document, layout_schema_version, semantic_hash, layout_hash, configuration_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'Review Example', 'Fictional review sample', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 100000.00000000, 100000.00000000, '{"elements":[{"key":"data-1","type":"PRICE_DATA","params":{"resolution":"1m"}},{"key":"ind-1","type":"RSI","params":{"period":14}},{"key":"cond-1","type":"THRESHOLD","params":{"operator":"LT","value":30}},{"key":"order-1","type":"MARKET_BUY","params":{}},{"key":"risk-1","type":"RISK_POLICY","params":{"maxPositionBps":5000}}],"edges":[{"key":"edge-1","from":"data-1.series","to":"ind-1.input"},{"key":"edge-2","from":"ind-1.value","to":"cond-1.input"},{"key":"edge-3","from":"cond-1.true","to":"order-1.trigger"}]}', '{"schemaVersion":"1.0.0","elements":{"data-1":{"x":80,"y":120,"width":180,"height":96},"ind-1":{"x":340,"y":120,"width":180,"height":96},"cond-1":{"x":600,"y":120,"width":180,"height":120},"order-1":{"x":860,"y":80,"width":180,"height":96},"risk-1":{"x":860,"y":260,"width":180,"height":96}},"edgeRoutes":{"edge-3":{"waypoints":[{"x":820,"y":180}]}},"groups":{},"viewport":{"x":0,"y":0,"zoom":1.0},"selectedElementKeys":[]}', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.flow_instruments {
  flow_id uuid [not null]
  instrument_id uuid [not null]

  indexes {
    (flow_id, instrument_id) [pk]
  }

  Note: '완성된 Flow semantic_document가 요구하는 명시적 종목의 불변 집합. 종목의 매매/참조 역할은 그 문서의 타입 Element과 엣지로 한 번 정의되며 여기에 가변 역할로 중복 저장하지 않는다. Flow와 원자적으로 삽입. 시작 검증은 종목 1개 이상과 추출된 의존성-행의 정확한 일치를 요구. 향후 유니버스 선택은 현재 범위 밖이며 제품 지원 시 별도 검토된 모델·마이그레이션으로 도입해야 한다.'

  Records (flow_id, instrument_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.flow_feature_requirements {
  flow_id uuid [not null]
  instrument_id uuid [not null]
  feature_definition_id uuid [not null]

  indexes {
    (flow_id, instrument_id, feature_definition_id) [pk]
    (feature_definition_id, instrument_id, flow_id)
  }

  Note: '완성 시 Flow semantic_document에서 추출한 불변 의존성 집합. 사용자 작성 상태가 아니며 예산도 부여하지 않는다. 역방향 인덱스로 서버가 동일 피처·종목 기준으로 활성 Flow을 묶어 공통 계산을 한 번 수행하고 여러 봇 평가로 팬아웃.'

  Records (flow_id, instrument_id, feature_definition_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.bot_events {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  event_sequence bigint [not null]
  event_type varchar(80) [not null]
  event_schema_version varchar(40) [not null]
  causation_event_id uuid
  correlation_id uuid [not null]
  idempotency_key varchar(160) [not null]
  occurred_at timestamptz [not null]
  received_at timestamptz [not null]
  committed_at timestamptz [not null, default: `now()`]
  summary_document jsonb [not null]
  market_dataset_manifest_id uuid
  evidence_object_id uuid

  indexes {
    (bot_id, event_sequence) [unique]
    (bot_id, id) [unique]
    (bot_id, idempotency_key) [unique]
    (event_type, committed_at)
    (correlation_id)
  }

  Note: '봇별 추가 전용 순서 보장 공식 스트림이자 라우팅된 트리거 이벤트의 유일한 봇별 구체화. Trigger Router가 전역 이벤트 식별자를 담은 결정적 idempotency_key(예: PRICE:AAPL:bar-close-timestamp, SCHEDULE:ONE_MINUTE:minute)로 라우팅 이벤트당 1행을 적재하므로 (bot_id, idempotency_key)가 별도 전역 트리거 테이블 없이 at-least-once 재전달을 흡수. event_sequence는 런타임 감사 순서이지 봇 버전이 아니며 갭 허용. 실행 차단 생명주기는 문서화된 이벤트 타입 BOT_EXECUTION_BLOCKED, BOT_EXECUTION_UNBLOCKED, SETTLEMENT_FAILED, LEDGER_INVARIANT_VIOLATED, STATE_REBUILD_COMPLETED 사용. 의사결정에 쓴 정확한 시장 관측치는 값/버전/해시로 고정.'

  Records (id, bot_id, event_sequence, event_type, event_schema_version, causation_event_id, correlation_id, idempotency_key, occurred_at, received_at, committed_at, summary_document, market_dataset_manifest_id, evidence_object_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 'REVIEW_EXAMPLE', '1.0.0', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '{"trigger":"PRICE","symbol":"AAPL","barClosedAt":"2026-07-24T10:00:00-04:00"}', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.flow_time_triggers {
  flow_id uuid [not null]
  trigger_type bot.time_trigger_type [not null]
  schedule_key varchar(40) [not null, note: '값은 SCHEDULE이면 ONE_MINUTE 같은 Interval 키, 세션 트리거면 고정값 NONE.']

  indexes {
    (flow_id, trigger_type, schedule_key) [pk]
    (trigger_type, schedule_key, flow_id)
  }

  Note: '완성된 Flow semantic_document에서 서버가 추출한 시간·세션 트리거 의존성 Projection. 사용자 작성이 아니고 제2의 정본도 아니다. 종목·피처 트리거 의존성은 flow_instruments와 flow_feature_requirements에 유지(중복 테이블 없음). 역방향 인덱스가 Trigger Router 조회에 답한다: MARKET_OPEN이나 ONE_MINUTE 이벤트는 구독한 Flow만 찾아 RUNNING 비차단 봇과 조인하며, 시장 전체 이벤트가 전체 봇을 스캔하지 않는다.'

  Records (flow_id, trigger_type, schedule_key) {
    '00000000-0000-4000-8000-000000000001', 'SCHEDULE', 'ONE_MINUTE'
  }
}

Table bot.evaluation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  trigger_event_id uuid [not null]
  result_event_id uuid [unique]
  feature_snapshot_batch_id uuid
  feature_snapshot_key varchar(200)
  feature_snapshot_hash varchar(128)
  status operations.work_status [not null]
  attempt_count int [not null, default: 0]
  lease_expires_at timestamptz [note: 'at-least-once 인계용 워커 lease. 만료되면 다른 공용 워커가 이어서 수행.']
  input_state_hash varchar(128)
  input_market_hash varchar(128) [note: '스냅샷이 고정된 경우 참조한 공유 피처 스냅샷 입력 해시와 같아야 한다.']
  candidate_set_hash varchar(128)
  candidate_count int
  state_change_count int
  result_hash varchar(128)
  summary_document jsonb
  queued_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
  failure_code varchar(80)

  indexes {
    (trigger_event_id, flow_id) [unique]
    (bot_id, id) [unique]
    (flow_id, queued_at)
    (bot_id, queued_at)
    (status, lease_expires_at)
    (feature_snapshot_batch_id, feature_snapshot_key)
  }

  checks {
    `attempt_count >= 0` [name: 'evaluation_attempt_count_nonnegative']
    `status <> 'SUCCEEDED' OR (completed_at IS NOT NULL AND result_hash IS NOT NULL)` [name: 'evaluation_success_complete']
  }

  Note: '트리거 이벤트당 Flow당 1행: 평가 큐, 사용자 노출 판단 로그, idempotency의 단위. 유일한 (trigger_event_id, flow_id) 쌍이 상류 bot_events (bot_id, idempotency_key), 하류 order_intent_batches (bot_id, source_event_id)와 함께 at-least-once 재전달을 끝까지 안전하게 만든다. runtime_state_values가 Flow 범위라 같은 봇의 Flow 평가는 공용 워커에서 병렬 가능하며, 봇 수준 예산·충돌 해소·이벤트 적용은 bot_id advisory lock 아래 주문 의도 배치 경계에서 직렬화되고 큐는 bot_id로 파티셔닝. 행은 라우팅 시 PENDING으로 등록. 시장 데이터 평가는 배치·키·해시로 불변 공유 피처 스냅샷 하나를 고정(공통 지표를 봇별 재계산하지 않음), MARKET_OPEN/MARKET_CLOSE/SCHEDULE 평가는 스냅샷 없이 가능. 최신만 평가하는 캐치업 정책에서 지연·차단 중 대체된 트리거는 failure_code CATCHUP_SUPERSEDED의 SKIPPED로만 기록되고 오래된 가격으로 평가되지 않는다. 마이그레이션은 Flow당 PENDING/RUNNING 1행을 허용하는 partial unique index 추가.'

  Records (id, bot_id, partition_id, flow_id, trigger_event_id, result_event_id, feature_snapshot_batch_id, feature_snapshot_key, feature_snapshot_hash, status, attempt_count, lease_expires_at, input_state_hash, input_market_hash, candidate_set_hash, candidate_count, state_change_count, result_hash, summary_document, queued_at, started_at, completed_at, failure_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'SUCCEEDED', 1, '2026-07-27T09:01:00+09:00', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, 1, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '{"decision":"ORDER_INTENT","firstFailedCondition":null,"notes":"RSI 28.4 < 30"}', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE'
  }
}

Table bot.runtime_state_values {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  instrument_id uuid
  element_instance_key varchar(160) [not null]
  state_definition_key varchar(160) [not null]
  value_type bot.runtime_value_type [not null]
  current_value jsonb [not null]
  last_event_sequence bigint [not null]
  updated_at timestamptz [not null]

  indexes {
    (bot_id, id) [unique]
    (bot_id, partition_id, flow_id, element_instance_key, state_definition_key, instrument_id) [unique]
    (bot_id, last_event_sequence)
  }

  Note: '평가 간 유지가 필요한 공식 봇 전용 Flow 상태만 PostgreSQL이 소유. 명시적 봇/파티션/Flow 소유가 봇 간 누출을 방지하고, instrument_id는 Flow 전역 상태에서만 null. 공유 가격·캔들·지표·캘린더·피처 값은 여기 금지이며 market_data 공유 계산이나 일회성 캐시 소관. instrument_id의 null-safe 유일성은 마이그레이션에서 강제.'

  Records (id, bot_id, partition_id, flow_id, instrument_id, element_instance_key, state_definition_key, value_type, current_value, last_event_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'REVIEW_EXAMPLE', 'DECIMAL', '{"value":28.4}', 1, '2026-07-27T09:00:00+09:00'
  }
}

Table bot.runtime_state_changes {
  bot_id uuid [not null]
  bot_event_id uuid [not null]
  runtime_state_value_id uuid [not null]
  previous_value_hash varchar(128) [note: '상태 키 최초 생성 시에만 null.']
  new_value jsonb [not null]
  new_value_hash varchar(128) [not null]
  change_reason_code varchar(80) [not null]

  indexes {
    (bot_event_id, runtime_state_value_id) [pk]
  }

  Note: '봇 전용 상태 변경의 추가 전용 before/after 증적. bot_id가 두 복합 참조에 모두 포함되어 이벤트가 다른 봇 소유 상태 행을 변경할 수 없다.'

  Records (bot_id, bot_event_id, runtime_state_value_id, previous_value_hash, new_value, new_value_hash, change_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, '{"value":28.4}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'REVIEW_EXAMPLE'
  }
}

