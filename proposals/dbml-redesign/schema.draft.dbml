  Note: 'Content-addressed server execution plan shared by semantically identical strategies. This is an infrastructure cache, not a reusable user strategy, version lineage, or copy relationship. The compiler validates typed blocks and emits only the minimal per-bot instructions; common market calculations are represented by required_feature_set_hash and executed outside the bot worker.'

  Records (id, catalog_version_id, semantic_hash, compiler_version, required_feature_set_hash, plan_document, plan_hash, created_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '{"example":true}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '2026-07-27T09:00:00+09:00'
  }
}

// -----------------------------------------------------------------------------
// storage: PostgreSQL manifests for immutable S3-compatible objects.
// -----------------------------------------------------------------------------

Table storage.objects {
  id uuid [pk, default: `gen_random_uuid()`]
  status storage.object_status [not null]
  storage_provider varchar(40) [not null]
  bucket_name varchar(160) [not null]
  object_key varchar(900) [not null]
  provider_version_id varchar(300) [not null]
  content_hash varchar(128) [not null]
  byte_size bigint [not null]
  file_format varchar(40) [not null, note: 'PARQUET for large tabular data in this draft.']
  compression_codec varchar(40) [not null, note: 'Explicitly UNCOMPRESSED for current Parquet objects.']
  media_type varchar(120) [not null]
  schema_version varchar(40) [not null]
  row_count bigint
  period_start timestamptz
  period_end timestamptz
  encryption_key_ref varchar(300)
  retention_policy_version varchar(80) [not null]
  retention_until timestamptz
  legal_hold boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz
  quarantined_at timestamptz
  superseded_at timestamptz
  deleted_at timestamptz

  indexes {
    (storage_provider, bucket_name, object_key, provider_version_id) [unique]
    (content_hash, byte_size)
    (status, created_at)
    (retention_until)
  }

  Note: 'An object becomes AVAILABLE only after size, hash, schema, Parquet footer, and codec verification. New revisions never overwrite authoritative object versions; deletion requires elapsed retention and no legal hold.'

  Records (id, status, storage_provider, bucket_name, object_key, provider_version_id, content_hash, byte_size, file_format, compression_codec, media_type, schema_version, row_count, period_start, period_end, encryption_key_ref, retention_policy_version, retention_until, legal_hold, created_at, verified_at, quarantined_at, superseded_at, deleted_at) {
