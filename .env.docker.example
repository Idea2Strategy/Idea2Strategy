COMPOSE_PROJECT_NAME=idea2strategy-local

# Local ports are bound to 127.0.0.1 only.
FRONTEND_PORT=15173
BACKEND_PORT=18080
BACKTEST_PORT=18082
ADMIN_MCP_PORT=18083
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
LOCALSTACK_PORT=14566

POSTGRES_DB=idea2strategy
POSTGRES_USER=idea2strategy
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
APP_POSTGRES_USER=idea2strategy_local_app
APP_POSTGRES_PASSWORD=__GENERATE_APP_POSTGRES_PASSWORD__

MINIO_ROOT_USER=idea2strategy
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_PASSWORD__
APP_S3_ACCESS_KEY=i2s-local-app
APP_S3_SECRET_KEY=__GENERATE_APP_S3_SECRET_KEY__
S3_REGION=ap-northeast-2
S3_MARKET_DATA_BUCKET=idea2strategy-local-market-data
S3_RESULTS_BUCKET=idea2strategy-local-results

AWS_REGION=ap-northeast-2
LOCALSTACK_DEBUG=0

# Same-origin by default: the vite dev proxy reaches backend-api (root #266).
# Set only when pointing the browser at a CORS-enabled external API origin.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Customer identity surface (backend-api). All four keys must be set or the
# signup/login/token controllers stay unregistered (fail-closed, root #266).
# These are LOCAL development keys only; the deployed environment supplies its
# own through the runtime secret store, never through this file.
IDENTITY_CRYPTO_EMAIL_ENCRYPTION_KEY=__GENERATE_IDENTITY_EMAIL_ENCRYPTION_KEY__
IDENTITY_CRYPTO_LOOKUP_HMAC_KEY=__GENERATE_IDENTITY_LOOKUP_HMAC_KEY__
IDENTITY_CRYPTO_VERIFICATION_HMAC_KEY=__GENERATE_IDENTITY_VERIFICATION_HMAC_KEY__
IDENTITY_CRYPTO_REFRESH_TOKEN_HMAC_KEY=__GENERATE_IDENTITY_REFRESH_TOKEN_HMAC_KEY__
IDENTITY_CRYPTO_CUSTOMER_JWT_SIGNING_KEY=__GENERATE_IDENTITY_CUSTOMER_JWT_SIGNING_KEY__
IDENTITY_JWT_REFRESH_COOKIE_SECURE=false

# Dedicated local worker-to-backtest-api credential. Do not reuse a customer
# customer credential or copy this generated Development value to an AWS environment.
BACKTEST_RESULT_INGEST_TOKEN=__GENERATE_BACKTEST_RESULT_INGEST_TOKEN__

# market-gateway 의 Alpaca 자격증명. 값을 커밋하지 않는다 — .env.docker 에만 넣는다.
# 없으면 게이트웨이가 fail-closed 로 기동을 거부하며, 그것이 의도된 동작이다.
# SIP 피드는 유료 구독을 요구한다(specs/product/decisions/decision.data.providers-alpaca-sip.md).
ALPACA_API_KEY=
ALPACA_API_SECRET=

# 게이트웨이(발행)와 trading-worker(소비)가 반드시 같은 값을 써야 한다. 다르면 워커가
# 다른 키 공간을 읽어 이벤트를 하나도 보지 못한다.
MARKET_EVENT_KEY_PREFIX=i2s
