COMPOSE_PROJECT_NAME=idea2strategy-local

# Local ports are bound to 127.0.0.1 only.
FRONTEND_PORT=15173
BACKEND_PORT=18080
BATCH_PORT=18081
BACKTEST_PORT=18082
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

POSTGRES_DB=idea2strategy
POSTGRES_USER=idea2strategy
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__

MINIO_ROOT_USER=idea2strategy
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_PASSWORD__
S3_REGION=ap-northeast-2
S3_MARKET_DATA_BUCKET=idea2strategy-local-market-data
S3_RESULTS_BUCKET=idea2strategy-local-results

VITE_API_BASE_URL=http://localhost:18080
VITE_WS_BASE_URL=ws://localhost:18080

# Used only by the optional backend-apps profile after the backend repository exists.
BACKEND_MIGRATION_DIR=./backend/db-migration/src/main/resources/db/migration
