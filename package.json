{
  "name": "idea2strategy-schema-tooling",
  "private": true,
  "scripts": {
    "dbml:validate": "node scripts/validate-dbml.mjs db/schema.dbml",
    "dbml:validate:a12": "node --test scripts/validate-account-lifecycle-contract.test.mjs",
    "dbml:validate:a13-proposal": "node scripts/validate-operator-rbac-proposal.mjs && node --test scripts/validate-operator-rbac-proposal.test.mjs",
    "dbml:validate:a15-proposal": "node scripts/validate-delegated-strategy-scope-proposal.mjs && node --test scripts/validate-delegated-strategy-scope-proposal.test.mjs",
    "dbml:validate:com-a-canonical": "node scripts/validate-dbml.mjs db/schema.dbml && node --test scripts/validate-com-a-canonical.test.mjs",
    "dbml:validate:case-deadline-canonical": "node scripts/validate-dbml.mjs db/schema.dbml && node --test scripts/validate-case-response-deadline-canonical.test.mjs",
    "dbml:validate:com-a21-canonical": "node scripts/validate-dbml.mjs db/schema.dbml && node --test scripts/validate-com-a21-batch-operator-canonical.test.mjs",
    "dbml:export:prepare": "node scripts/prepare-dbdiagram-export.mjs",
    "dbml:export:test": "node --test scripts/prepare-dbdiagram-export.test.mjs",
    "dbml:validate:trading-proposal": "node scripts/validate-trading-dbml.mjs proposals/dbml-redesign/schema.draft.dbml",
    "dbml:validate:competition-proposal": "node scripts/validate-competition-dbml.mjs proposals/dbml-redesign/schema.draft.dbml",
    "dbml:validate:backtest-performance-proposal": "node scripts/validate-backtest-performance-dbml.mjs proposals/dbml-redesign/schema.draft.dbml",
    "proposal:validate:boundary": "node scripts/validate-proposal-boundary.mjs origin/develop",
    "proposal:validate:corporate-action-approval": "node --test proposals/corporate-action-approval/validate-contract.test.mjs",
    "contract:validate:corporate-action-approval": "node --test scripts/validate-corporate-action-approval-canonical.test.mjs",
    "contract:validate:release-adoption": "node --test scripts/validate-release-protected-contracts.test.mjs",
    "contract:validate:registry": "node --test scripts/validate-contract-registry.test.mjs",
    "contract:validate:basic-strategy": "node scripts/validate-basic-strategy-conformance.mjs",
    "dbdiagram": "dbdiagram"
  },
  "devDependencies": {
    "@dbml/core": "8.2.5",
    "dbdiagram": "0.2.0"
  }
}
