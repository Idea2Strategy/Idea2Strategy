FROM gradle:8.14.3-jdk21-alpine AS builder

ARG SERVICE_DIR
ARG APP_PROJECT
ARG APP_OUTPUT
WORKDIR /workspace

COPY --chown=gradle:gradle ${SERVICE_DIR}/ ./

RUN test -n "${SERVICE_DIR}" \
    && test -n "${APP_PROJECT}" \
    && test -n "${APP_OUTPUT}" \
    && gradle ":${APP_PROJECT}:bootJar" --no-daemon \
    && find "${APP_OUTPUT}/build/libs" -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit \
       | xargs -r -I '{}' cp '{}' /tmp/app.jar \
    && test -f /tmp/app.jar

FROM eclipse-temurin:21-jre-alpine

RUN addgroup -S app \
    && adduser -S -G app app

WORKDIR /app
COPY --from=builder /tmp/app.jar /app/app.jar

USER app
EXPOSE 8080 8083

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
