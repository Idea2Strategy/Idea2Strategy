FROM eclipse-temurin:21-jdk-alpine AS builder

ARG APP_MODULE
WORKDIR /workspace

COPY backend/ ./

RUN test -n "${APP_MODULE}" \
    && test -f gradlew \
    && sed -i 's/\r$//' gradlew \
    && chmod +x gradlew \
    && ./gradlew ":${APP_MODULE}:bootJar" --no-daemon \
    && find "${APP_MODULE}/build/libs" -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit \
       | xargs -r -I '{}' cp '{}' /tmp/app.jar \
    && test -f /tmp/app.jar

FROM eclipse-temurin:21-jre-alpine

RUN addgroup -S app \
    && adduser -S -G app app

WORKDIR /app
COPY --from=builder /tmp/app.jar /app/app.jar

USER app
EXPOSE 8080 8081 8082

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
