      "trueInputs": {"currentPrice": 103.5, "referencePrice": 100},
      "falseInputs": {"currentPrice": 102, "referencePrice": 100},
      "expectedReviewKo": "1시간 등락률이 전일 종가 대비 3.5% 이상"
    },
