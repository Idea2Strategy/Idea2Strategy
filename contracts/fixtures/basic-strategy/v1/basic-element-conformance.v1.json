      "operation": "STREAK",
      "arguments": {"resolution": "1d", "direction": "UP", "count": 3},
      "trueInputs": {"closes": [100, 101, 102, 103]},
      "falseInputs": {"closes": [100, 101, 100, 103]},
      "expectedReviewKo": "일봉 종가가 3회 연속 상승"
    },
    {
