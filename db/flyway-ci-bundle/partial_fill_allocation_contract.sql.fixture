-- PostgreSQL 16 contract probe for the canonical partial-fill contribution.
-- Run only against an ephemeral migrated database as a PostgreSQL superuser.
-- Parent rows outside trading are intentionally bypassed while the focused
-- trading aggregate is seeded; all assertions execute with normal triggers.

SET session_replication_role = replica;

