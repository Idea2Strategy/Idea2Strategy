    'contract-probe-consumed', 2, 'CONSUMED_BY_FILL', 40.08,
    'ACTIVE', now(), repeat('e', 64)
);

SET session_replication_role = origin;

-- Two individual fills for one order, exact allocation economics, cumulative
-- component capacity and a still-ACTIVE partially consumed reservation pass.
SELECT trading.assert_fill_allocation_totals('13000000-0000-4000-8000-000000000001');
SELECT trading.assert_fill_allocation_totals('13000000-0000-4000-8000-000000000002');
SELECT trading.assert_component_allocation_capacity('12000000-0000-4000-8000-000000000001');
SELECT trading.assert_order_fill_state('11000000-0000-4000-8000-000000000001');
SELECT trading.assert_reservation_event_totals('15000000-0000-4000-8000-000000000001');
SELECT trading.assert_fill_reservation_consumption('16000000-0000-4000-8000-000000000002');

DO $$
BEGIN
    BEGIN
        UPDATE trading.fill_component_allocations
           SET allocated_fee_amount = 0.07
         WHERE id = '14000000-0000-4000-8000-000000000001';
        SET CONSTRAINTS ALL IMMEDIATE;
        RAISE EXCEPTION 'expected exact fill allocation failure was not raised';
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM LIKE 'expected exact fill allocation failure%' THEN RAISE; END IF;
    END;

    BEGIN
        UPDATE trading.order_components
           SET component_quantity = 9
         WHERE id = '12000000-0000-4000-8000-000000000001';
        PERFORM trading.assert_component_allocation_capacity(
            '12000000-0000-4000-8000-000000000001');
        RAISE EXCEPTION 'expected cumulative component overfill failure was not raised';
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM LIKE 'expected cumulative component overfill failure%' THEN RAISE; END IF;
    END;

    BEGIN
        UPDATE trading.resource_reservations
           SET consumed_amount = 39
         WHERE id = '15000000-0000-4000-8000-000000000001';
        SET CONSTRAINTS ALL IMMEDIATE;
        RAISE EXCEPTION 'expected reservation projection failure was not raised';
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM LIKE 'expected reservation projection failure%' THEN RAISE; END IF;
    END;

    BEGIN
        UPDATE trading.fill_component_allocations
           SET bot_id = '20000000-0000-4000-8000-000000000099'
         WHERE id = '14000000-0000-4000-8000-000000000001';
        RAISE EXCEPTION 'expected cross-scope allocation failure was not raised';
    EXCEPTION WHEN foreign_key_violation THEN NULL;
    END;
END $$;
