    id, bot_id, batch_id, source_event_id, origin_type, partition_id, flow_id,
    instrument_id, intent_key, side, position_effect, order_type, time_in_force,
    requested_quantity, approved_quantity, post_netting_quantity, final_quantity,
    decision, decision_reason_code
) VALUES (
    '10000000-0000-4000-8000-000000000001',
    '20000000-0000-4000-8000-000000000001',
    '30000000-0000-4000-8000-000000000001',
    '40000000-0000-4000-8000-000000000001',
    'SYSTEM_STOP_LIQUIDATION',
    '50000000-0000-4000-8000-000000000001',
    '60000000-0000-4000-8000-000000000001',
    '70000000-0000-4000-8000-000000000001',
    'contract-probe-intent', 'BUY', 'OPEN_LONG', 'MARKET', 'DAY',
    10, 10, 10, 10, 'APPROVED', 'CONTRACT_PROBE'
);

