    id, owner_account_id, mode, name, lifecycle_status, lifecycle_changed_at,
    created_at, execution_eligible_from, deleted_at
) VALUES
('b0000000-0000-4000-8000-000000000001', 'a0000000-0000-4000-8000-000000000001',
 'BASIC', 'F15 read contract bot', 'RUNNING', '2026-07-28T09:00:00+00',
 '2026-07-28T09:00:00+00', '2026-07-28T09:00:00+00', NULL),
('b0000000-0000-4000-8000-000000000002', 'a0000000-0000-4000-8000-000000000002',
 'BASIC', 'Another owner bot', 'RUNNING', '2026-07-28T09:00:00+00',
 '2026-07-28T09:00:00+00', '2026-07-28T09:00:00+00', NULL),
('b0000000-0000-4000-8000-000000000003', 'a0000000-0000-4000-8000-000000000001',
 'BASIC', 'Logically deleted bot', 'STOPPED', '2026-07-28T09:00:00+00',
 '2026-07-28T09:00:00+00', '2026-07-28T09:00:00+00', '2026-07-29T09:00:00+00');

