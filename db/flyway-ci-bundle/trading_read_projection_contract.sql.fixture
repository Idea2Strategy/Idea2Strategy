PREPARE projection_bot_budget AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
)
select p.bot_id,
       p.currency_code,
       p.available_cash_amount,
       p.active_reservation_amount,
       p.invested_amount,
       p.segregated_short_proceeds_amount,
       p.short_collateral_amount,
       p.valuation_at,
       p.valuation_status,
       p.last_event_sequence,
       p.updated_at
  from trading.bot_budget_projections p
  join owned_bot ob on ob.bot_id = p.bot_id
;

PREPARE projection_flow_fills AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id, f.id as flow_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
      join bot.flows f
        on f.partition_id = p.id
       and f.id = cast($4 as uuid)
)
select f.id as fill_id,
       f.order_id,
       f.provider_fill_key,
       f.quantity,
       f.reference_price,
       f.reference_observed_at,
       f.slippage_rate_bps,
       f.slippage_amount,
       f.fill_price,
       f.gross_amount,
       f.fee_rate_bps,
       f.fee_amount,
       f.settlement_cash_delta,
       f.occurred_at,
       a.id as allocation_id,
       a.allocation_sequence,
       a.allocated_quantity,
       a.allocated_gross_amount,
       a.allocated_fee_amount,
       a.allocated_settlement_cash_delta
  from trading.fills f
  join scope s
    on s.bot_id = f.bot_id
   and s.partition_id = f.partition_id
  join trading.fill_component_allocations a
    on a.fill_id = f.id
   and a.bot_id = f.bot_id
   and a.partition_id = f.partition_id
  join trading.order_components c
    on c.id = a.order_component_id
   and c.bot_id = a.bot_id
   and c.partition_id = a.partition_id
  join trading.order_intents i
    on i.id = c.intent_id
   and i.flow_id = s.flow_id
 order by f.occurred_at, f.id, a.allocation_sequence
 limit $5 offset $6
;

PREPARE projection_flow_ledger_entries AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id, f.id as flow_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
      join bot.flows f
        on f.partition_id = p.id
       and f.id = cast($4 as uuid)
)
select t.id as transaction_id,
       t.transaction_type,
       t.transaction_key,
       t.source_type,
       t.source_id,
       t.currency_code,
       t.reversal_of_transaction_id,
       t.occurred_at,
       t.description_code,
       e.id as entry_id,
       e.entry_sequence,
       e.direction,
       e.amount,
       e.quantity,
       la.account_key,
       la.account_type
  from trading.ledger_transactions t
  join scope s
    on s.bot_id = t.bot_id
   and s.partition_id = t.partition_id
  join trading.ledger_entries e
    on e.transaction_id = t.id
   and e.bot_id = t.bot_id
   and e.partition_id = t.partition_id
  join trading.ledger_accounts la
    on la.id = e.ledger_account_id
   and la.bot_id = e.bot_id
  join trading.order_components c
    on c.id = e.order_component_id
   and c.bot_id = e.bot_id
   and c.partition_id = e.partition_id
  join trading.order_intents i
    on i.id = c.intent_id
   and i.flow_id = s.flow_id
 order by t.occurred_at, t.id, e.entry_sequence
 limit $5 offset $6
;

PREPARE projection_flow_orders AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id, f.id as flow_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
      join bot.flows f
        on f.partition_id = p.id
       and f.id = cast($4 as uuid)
)
select o.id as order_id,
       o.instrument_id,
       o.order_key,
       o.side,
       o.order_type,
       o.time_in_force,
       o.requested_quantity,
       o.limit_price,
       o.stop_price,
       o.accepted_at,
       o.expires_at,
       sp.status,
       sp.filled_quantity,
       sp.remaining_quantity,
       sp.reserved_cash,
       sp.reserved_quantity,
       sp.last_order_event_sequence,
       sp.updated_at
  from trading.orders o
  join scope s
    on s.bot_id = o.bot_id
   and s.partition_id = o.partition_id
  join trading.order_state_projections sp
    on sp.order_id = o.id
   and sp.bot_id = o.bot_id
   and sp.partition_id = o.partition_id
 where exists (
           select 1
             from trading.order_components c
             join trading.order_intents i
               on i.id = c.intent_id
            where c.order_id = o.id
              and c.bot_id = o.bot_id
              and c.partition_id = o.partition_id
              and i.flow_id = s.flow_id
       )
 order by o.accepted_at, o.id
 limit $5 offset $6
;

PREPARE projection_flow_positions AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id, f.id as flow_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
      join bot.flows f
        on f.partition_id = p.id
       and f.id = cast($4 as uuid)
)
select p.instrument_id,
       p.long_quantity,
       p.short_quantity,
       p.cost_basis_amount,
       p.last_event_sequence,
       p.projection_hash,
       p.updated_at
  from trading.flow_position_projections p
  join scope s
    on s.bot_id = p.bot_id
   and s.partition_id = p.partition_id
   and s.flow_id = p.flow_id
 order by p.instrument_id
 limit $5 offset $6
;

PREPARE projection_flow_reasons AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id, f.id as flow_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
      join bot.flows f
        on f.partition_id = p.id
       and f.id = cast($4 as uuid)
)
select r.reason_id,
       r.order_id,
       r.scope_level,
       r.reason_type,
       r.reason_code,
       r.detail,
       r.occurred_at
  from (
        select i.id as reason_id,
               null::uuid as order_id,
               'FLOW' as scope_level,
               'REJECTION' as reason_type,
               i.decision_reason_code as reason_code,
               i.decision::text as detail,
               ib.finalized_at as occurred_at
          from trading.order_intents i
          join scope s
            on s.bot_id = i.bot_id
           and s.partition_id = i.partition_id
           and s.flow_id = i.flow_id
          join trading.order_intent_batches ib
            on ib.id = i.batch_id
           and ib.bot_id = i.bot_id
           and ib.partition_id = i.partition_id
         where i.decision in ('REJECTED', 'CONFLICTED')

        union all

        select i.id,
               null::uuid,
               'FLOW',
               'RESIZE',
               i.decision_reason_code,
               concat_ws(
                   '/',
                   coalesce(i.requested_quantity, i.requested_notional)::text,
                   i.post_netting_quantity::text,
                   coalesce(i.final_quantity, i.final_notional, 0)::text),
               ib.finalized_at
          from trading.order_intents i
          join scope s
            on s.bot_id = i.bot_id
           and s.partition_id = i.partition_id
           and s.flow_id = i.flow_id
          join trading.order_intent_batches ib
            on ib.id = i.batch_id
           and ib.bot_id = i.bot_id
           and ib.partition_id = i.partition_id
         where i.decision in ('REDUCED', 'NETTED')

        union all

        select oe.id,
               oe.order_id,
               'FLOW',
               case when oe.new_status = 'REJECTED' then 'REJECTION'
                    else 'SETTLEMENT' end,
               oe.reason_code,
               oe.event_type,
               oe.occurred_at
          from trading.order_events oe
          join scope s
            on s.bot_id = oe.bot_id
           and s.partition_id = oe.partition_id
         where oe.reason_code is not null
           and oe.new_status in ('REJECTED', 'CANCELLED', 'EXPIRED')
           and exists (
                   select 1
                     from trading.order_components c
                     join trading.order_intents i
                       on i.id = c.intent_id
                    where c.order_id = oe.order_id
                      and c.bot_id = oe.bot_id
                      and c.partition_id = oe.partition_id
                      and i.flow_id = s.flow_id
               )

        union all

        select sca.id,
               null::uuid,
               'FLOW',
               'SETTLEMENT',
               sca.reason_type::text,
               sca.reason_document::text,
               sca.created_at
          from trading.system_close_actions sca
          join scope s
            on s.bot_id = sca.bot_id
           and s.partition_id = sca.partition_id
           and s.flow_id = sca.flow_id
       ) r
 order by r.occurred_at, r.reason_type, r.reason_id
 limit $5 offset $6
;

PREPARE projection_flow_reservations AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id, f.id as flow_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
      join bot.flows f
        on f.partition_id = p.id
       and f.id = cast($4 as uuid)
)
select r.id as reservation_id,
       r.reservation_key,
       r.intent_id,
       r.resource_type,
       r.status,
       r.currency_code,
       r.instrument_id,
       r.reserved_amount,
       r.consumed_amount,
       r.released_amount,
       r.reserved_quantity,
       r.consumed_quantity,
       r.released_quantity,
       r.created_at,
       r.last_event_sequence
  from trading.resource_reservations r
  join scope s
    on s.bot_id = r.bot_id
   and s.partition_id = r.partition_id
   and s.flow_id = r.flow_id
 order by r.created_at, r.id
 limit $5 offset $6
;

PREPARE projection_partition_budgets AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
)
select p.bot_id,
       p.partition_id,
       p.currency_code,
       p.budget_cap_amount,
       p.active_reservation_amount,
       p.invested_amount,
       p.segregated_short_proceeds_amount,
       p.short_collateral_amount,
       p.valuation_at,
       p.valuation_status,
       p.last_event_sequence,
       p.updated_at
  from trading.partition_budget_projections p
  join owned_bot ob on ob.bot_id = p.bot_id
 order by p.partition_id
 limit $3 offset $4
;

PREPARE projection_partition_positions AS
with owned_bot as (
    select b.id as bot_id
      from bot.bots b
     where b.owner_account_id = cast($1 as uuid)
       and b.id = cast($2 as uuid)
       and b.deleted_at is null
),
scope as (
    select ob.bot_id, p.id as partition_id
      from owned_bot ob
      join bot.bot_partitions p
        on p.bot_id = ob.bot_id
       and p.id = cast($3 as uuid)
)
select p.instrument_id,
       p.net_quantity,
       p.average_cost,
       p.realized_pnl,
       p.last_valuation_price,
       p.last_valuation_at,
       p.valuation_status,
       p.last_bot_event_sequence,
       p.updated_at
  from trading.partition_position_projections p
  join scope s
    on s.bot_id = p.bot_id
   and s.partition_id = p.partition_id
 order by p.instrument_id
 limit $4 offset $5
;

-- The owner of bot b0000000-...-0001 reading partition c0000000-...-0001 and
-- flow d0000000-...-0001.
CREATE TEMP TABLE owner_bot_budget AS
EXECUTE projection_bot_budget(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001');

CREATE TEMP TABLE owner_partition_budgets AS
EXECUTE projection_partition_budgets(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE owner_flow_reservations AS
EXECUTE projection_flow_reservations(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE owner_flow_positions AS
EXECUTE projection_flow_positions(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE owner_partition_positions AS
EXECUTE projection_partition_positions(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 50, 0);

CREATE TEMP TABLE owner_flow_orders AS
EXECUTE projection_flow_orders(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE owner_flow_fills AS
EXECUTE projection_flow_fills(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE owner_flow_ledger_entries AS
EXECUTE projection_flow_ledger_entries(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE owner_flow_reasons AS
EXECUTE projection_flow_reasons(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

-- The same reads issued by a different account, and by the owner against a
-- logically deleted bot.
CREATE TEMP TABLE stranger_bot_budget AS
EXECUTE projection_bot_budget(
    'a0000000-0000-4000-8000-000000000002', 'b0000000-0000-4000-8000-000000000001');

CREATE TEMP TABLE stranger_flow_fills AS
EXECUTE projection_flow_fills(
    'a0000000-0000-4000-8000-000000000002', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE stranger_flow_reasons AS
EXECUTE projection_flow_reasons(
    'a0000000-0000-4000-8000-000000000002', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    50, 0);

CREATE TEMP TABLE deleted_bot_budget AS
EXECUTE projection_bot_budget(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000003');

-- A flow identifier that belongs to another partition must not widen the read.
CREATE TEMP TABLE mismatched_flow_positions AS
EXECUTE projection_flow_positions(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000003',
    50, 0);

-- Deterministic paging over the two individual fills of the requested flow.
CREATE TEMP TABLE owner_flow_fills_page_one AS
EXECUTE projection_flow_fills(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    1, 0);

CREATE TEMP TABLE owner_flow_fills_page_two AS
EXECUTE projection_flow_fills(
    'a0000000-0000-4000-8000-000000000001', 'b0000000-0000-4000-8000-000000000001',
    'c0000000-0000-4000-8000-000000000001', 'd0000000-0000-4000-8000-000000000001',
    1, 1);

DO $$
DECLARE
    actual text;
BEGIN
    -- Budgets.
    IF (SELECT count(*) FROM owner_bot_budget) <> 1
        OR (SELECT available_cash_amount FROM owner_bot_budget) <> 900.00000000 THEN
        RAISE EXCEPTION 'bot budget projection did not return the owned bot budget';
    END IF;
    IF (SELECT count(*) FROM owner_partition_budgets) <> 2 THEN
        RAISE EXCEPTION 'partition budgets must list exactly the two owned partitions';
    END IF;
    SELECT string_agg(partition_id::text, ',') INTO actual FROM owner_partition_budgets;
    IF actual <> 'c0000000-0000-4000-8000-000000000001,'
                 || 'c0000000-0000-4000-8000-000000000002' THEN
        RAISE EXCEPTION 'partition budgets are not deterministically ordered: %', actual;
    END IF;

    -- Reservations behind the flow budget.
    IF (SELECT count(*) FROM owner_flow_reservations) <> 1
        OR (SELECT reservation_key FROM owner_flow_reservations) <> 'P1:FLOW1:CASH:1' THEN
        RAISE EXCEPTION 'flow reservations leaked across flows';
    END IF;

    -- Positions.
    IF (SELECT count(*) FROM owner_flow_positions) <> 1
        OR (SELECT long_quantity FROM owner_flow_positions) <> 10.00000000 THEN
        RAISE EXCEPTION 'flow positions leaked across flows';
    END IF;
    IF (SELECT count(*) FROM owner_partition_positions) <> 2 THEN
        RAISE EXCEPTION 'partition positions leaked across partitions';
    END IF;
    SELECT string_agg(instrument_id::text, ',') INTO actual FROM owner_partition_positions;
    IF actual <> 'e0000000-0000-4000-8000-000000000001,'
                 || 'e0000000-0000-4000-8000-000000000002' THEN
        RAISE EXCEPTION 'partition positions are not deterministically ordered: %', actual;
    END IF;

    -- Orders. Only the order carrying a component of the requested flow.
    IF (SELECT count(*) FROM owner_flow_orders) <> 1 THEN
        RAISE EXCEPTION 'flow orders leaked across flows in the same partition';
    END IF;
    IF (SELECT order_id FROM owner_flow_orders)
        <> '13000000-0000-4000-8000-000000000001' THEN
        RAISE EXCEPTION 'flow orders returned the wrong order';
    END IF;
    IF (SELECT status FROM owner_flow_orders)::text <> 'CANCELLED'
        OR (SELECT filled_quantity FROM owner_flow_orders) <> 10
        OR (SELECT requested_quantity FROM owner_flow_orders) <> 12 THEN
        RAISE EXCEPTION 'flow orders lost the rebuildable partial fill state';
    END IF;

    -- Individual fills stay individual and keep their exact allocation economics.
    IF (SELECT count(*) FROM owner_flow_fills) <> 2 THEN
        RAISE EXCEPTION 'individual fills were collapsed or leaked';
    END IF;
    SELECT string_agg(quantity::text, ',' ORDER BY occurred_at) INTO actual
      FROM owner_flow_fills;
    IF actual <> '4.00000000,6.00000000' THEN
        RAISE EXCEPTION 'individual fills are not deterministically ordered: %', actual;
    END IF;
    IF (SELECT sum(allocated_settlement_cash_delta) FROM owner_flow_fills)
        <> -100.25000000 THEN
        RAISE EXCEPTION 'flow attributed fill economics are wrong';
    END IF;

    -- Official ledger lines of the requested flow only.
    IF (SELECT count(*) FROM owner_flow_ledger_entries) <> 4 THEN
        RAISE EXCEPTION 'official ledger entries leaked across flows';
    END IF;
    SELECT string_agg(entry_sequence::text, ',' ORDER BY occurred_at, transaction_id,
                      entry_sequence) INTO actual FROM owner_flow_ledger_entries;
    IF actual <> '1,2,1,2' THEN
        RAISE EXCEPTION 'ledger entry order was not preserved: %', actual;
    END IF;
    IF (SELECT sum(amount) FROM owner_flow_ledger_entries
         WHERE direction = 'DEBIT') <> 100.25000000
        OR (SELECT sum(amount) FROM owner_flow_ledger_entries
             WHERE direction = 'CREDIT') <> 100.25000000 THEN
        RAISE EXCEPTION 'the flow ledger view is not balanced';
    END IF;

    -- Rejection, reduction and settlement reasons.
    IF (SELECT count(*) FROM owner_flow_reasons) <> 4 THEN
        RAISE EXCEPTION 'flow reasons leaked or lost rows: %',
            (SELECT count(*) FROM owner_flow_reasons);
    END IF;
    SELECT string_agg(reason_type || ':' || reason_code, ','
                      ORDER BY occurred_at, reason_type, reason_id) INTO actual
      FROM owner_flow_reasons;
    IF actual <> 'REJECTION:PARTITION_BUDGET_EXCEEDED,'
                 || 'RESIZE:RISK_LIMIT_REDUCED,'
                 || 'SETTLEMENT:REPLACED_BY_AUTOMATIC_REPLACEMENT,'
                 || 'SETTLEMENT:BOT_STOP' THEN
        RAISE EXCEPTION 'flow reasons are wrong or misordered: %', actual;
    END IF;
    IF (SELECT detail FROM owner_flow_reasons WHERE reason_type = 'RESIZE')
        <> '20.00000000/20.00000000/10.00000000' THEN
        RAISE EXCEPTION 'the reduction reason lost its requested and final quantities';
    END IF;

    -- Ownership and lifecycle gates.
    IF (SELECT count(*) FROM stranger_bot_budget) <> 0
        OR (SELECT count(*) FROM stranger_flow_fills) <> 0
        OR (SELECT count(*) FROM stranger_flow_reasons) <> 0 THEN
        RAISE EXCEPTION 'another account could read this bot';
    END IF;
    IF (SELECT count(*) FROM deleted_bot_budget) <> 0 THEN
        RAISE EXCEPTION 'a logically deleted bot was still readable';
    END IF;
    IF (SELECT count(*) FROM mismatched_flow_positions) <> 0 THEN
        RAISE EXCEPTION 'a flow of another partition widened the read';
    END IF;

    -- Paging is deterministic and does not repeat or skip a fill.
    IF (SELECT count(*) FROM owner_flow_fills_page_one) <> 1
        OR (SELECT count(*) FROM owner_flow_fills_page_two) <> 1 THEN
        RAISE EXCEPTION 'paged fill reads returned the wrong page size';
    END IF;
    IF (SELECT fill_id FROM owner_flow_fills_page_one)
        = (SELECT fill_id FROM owner_flow_fills_page_two) THEN
        RAISE EXCEPTION 'paged fill reads repeated the same fill';
    END IF;
    IF (SELECT quantity FROM owner_flow_fills_page_one) <> 4.00000000
        OR (SELECT quantity FROM owner_flow_fills_page_two) <> 6.00000000 THEN
        RAISE EXCEPTION 'paged fill reads are not in the contracted order';
    END IF;
END $$;
