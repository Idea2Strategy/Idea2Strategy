-- PostgreSQL 16 contract probe for the F15 canonical trading read projections.
-- Run only against an ephemeral migrated database as a PostgreSQL superuser.
-- Parent rows outside bot and trading are intentionally bypassed while the focused
-- read aggregate is seeded; all assertions execute with normal triggers.
--
-- The PREPARE statements below must stay byte identical to the statements shipped in
-- com.idea2strategy.trading.persistence.projection.CanonicalTradingReadSql, apart from
-- the JDBC "?" placeholders becoming PostgreSQL "$n" placeholders.
-- CanonicalTradingReadContractTest fails the trading engine build when they drift.

SET session_replication_role = replica;

-- Two owners. Only a0000000-...-0001 may ever see bot b0000000-...-0001.
