    '00000000-0000-4000-8000-000000000002', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'RUNNING', '2023-01-01', '2023-12-31', 100000.00000000, '1.0.0', '1.0.0', '1.0.0', '00000000-0000-4000-8000-000000000001', 5, '00000000-0000-4000-8000-000000000001', 'USER_BACKTEST:00000000-0000-4000-8000-000000000002', '2026-07-28T09:00:00+09:00', '2026-07-28T09:00:01+09:00', null, null, null
    '00000000-0000-4000-8000-000000000003', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'COMPLETED', '2020-02-01', '2020-04-30', 100000.00000000, '1.0.0', '1.0.0', '1.0.0', '00000000-0000-4000-8000-000000000001', 5, '00000000-0000-4000-8000-000000000001', 'COMPETITION_PERIOD:00000000-0000-4000-8000-000000000003', '2026-07-28T10:00:01+09:00', '2026-07-28T10:00:02+09:00', '2026-07-28T10:04:59+09:00', null, 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc'
    '00000000-0000-4000-8000-000000000004', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'COMPLETED', '2022-01-01', '2022-06-30', 100000.00000000, '1.0.0', '1.0.0', '1.0.0', '00000000-0000-4000-8000-000000000001', 5, '00000000-0000-4000-8000-000000000001', 'COMPETITION_PERIOD:00000000-0000-4000-8000-000000000004', '2026-07-28T10:00:01+09:00', '2026-07-28T10:00:02+09:00', '2026-07-28T10:09:59+09:00', null, 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
  }
}

