  Records (id, participation_id, event_sequence, event_type, reason_code, occurred_at, payload_document) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 'PARTICIPATION_ACCEPTED', null, '2026-07-28T10:00:00+09:00', '{"alias":"bot-orchid-07","slotConsumed":true,"cancellationAllowed":false}'
  }
