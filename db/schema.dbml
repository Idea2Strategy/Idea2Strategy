// -----------------------------------------------------------------------------
// strategy: editable user Strategy sources and platform-owned Flow building assets.
// Publishing copies a validated snapshot into bot; no Strategy-to-Bot provenance remains.
// -----------------------------------------------------------------------------

Table strategy.strategies {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_account_id uuid [not null]
  mode strategy.strategy_mode [not null]
  name varchar(120) [not null]
  description text
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  deleted_at timestamptz

  indexes {
    (owner_account_id, deleted_at, archived_at, updated_at)
  }

  Note: '사용자가 계속 수정할 수 있는 Strategy 설계 원본의 식별·표시·수명주기 메타데이터. 실행 Bot을 소유하거나 연결하지 않는다. 출시 시 strategy_documents의 검증된 당시 상태를 독립 Bot 스냅샷으로 복사하며 Bot에는 원본 Strategy 식별자·출처·계보를 남기지 않는다. 이후 Strategy 수정은 기존 Bot에 전파되지 않는다.'

  Records (id, owner_account_id, mode, name, description, edit_sequence, created_at, updated_at, archived_at, deleted_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'BASIC', 'RSI 전략 모음', '검토용 사용자 Strategy', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', null, null
  }
}

Table strategy.strategy_documents {
  strategy_id uuid [pk]
  semantic_document jsonb [not null, note: '파티션 예산 상한, Flow, Element, edge, 매개변수, 선택 종목을 포함하는 수정 가능한 Strategy 설계 의미. 편집 중에는 미완성 구조를 허용하되 schema에 맞게 파싱 가능해야 한다.']
  presentation_document jsonb [not null, note: '파티션·Flow·Element 좌표, 크기, edge route, viewport 같은 UI 배치 정보. semantic_document와 동일한 안정 키를 참조한다.']
  semantic_schema_version varchar(40) [not null]
  presentation_schema_version varchar(40) [not null]
  semantic_hash varchar(128) [not null]
  presentation_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (semantic_hash)
    (updated_at)
  }

  Note: 'Strategy 편집기의 현재 문서 1개를 저장하는 1:1 집합체. 버전 계보가 아니라 낙관적 동시성으로 갱신되는 현재 설계다. 출시 서비스는 완전성·포트 타입·DAG·예산 합·필수 주문 경로를 검증한 동일 트랜잭션에서 독립 bot.bots, bot.launch_snapshots, bot.launch_configurations, bot.bot_partitions, bot.flows 및 파생 의존성 행을 생성한다. 생성 후 Strategy와 Bot 사이에는 어떤 참조도 없다.'

  Records (strategy_id, semantic_document, presentation_document, semantic_schema_version, presentation_schema_version, semantic_hash, presentation_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '{"partitions":[{"key":"partition-1","budgetCapBps":5000,"flows":[{"key":"flow-1","elements":[],"edges":[],"instrumentIds":[]}]}]}', '{"partitions":{"partition-1":{"x":100,"y":100}},"flows":{"flow-1":{"x":300,"y":100}},"elements":{},"edgeRoutes":{},"viewport":{"x":0,"y":0,"zoom":1.0}}', '1.0.0', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table strategy.strategy_edit_leases {
  strategy_id uuid [pk]
  session_id uuid
  delegated_credential_id uuid
  lease_token_digest varchar(128) [not null, unique]
  digest_key_version smallint [not null]
  acquired_at timestamptz [not null]
  heartbeat_at timestamptz [not null]
  expires_at timestamptz [not null]

  indexes {
    (expires_at)
  }

  checks {
    `(session_id IS NOT NULL AND delegated_credential_id IS NULL) OR (session_id IS NULL AND delegated_credential_id IS NOT NULL)` [name: 'strategy_edit_lease_exactly_one_editor']
    `digest_key_version > 0` [name: 'strategy_edit_lease_digest_key_version_positive']
    `heartbeat_at >= acquired_at AND expires_at > heartbeat_at` [name: 'strategy_edit_lease_time_order_valid']
  }

  Note: 'Allows exactly one active editor across the web, direct user CLI, and delegated external AI. Revoked or expired credentials invalidate the lease, and a stale edit_sequence or lease token rejects late saves.'

  Records (strategy_id, session_id, delegated_credential_id, lease_token_digest, digest_key_version, acquired_at, heartbeat_at, expires_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:05:00+09:00'
  }
}

Table strategy.validation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  strategy_id uuid [not null]
  requested_by_account_id uuid [not null]
  delegated_authorization_id uuid
  requested_edit_sequence bigint [not null]
  semantic_hash varchar(128) [not null]
  element_catalog_version_id uuid [not null]
  status varchar(30) [not null, note: 'RUNNING, VALID, INVALID, or FAILED.']
  issue_count int [not null, default: 0]
  result_document jsonb [not null]
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (strategy_id, requested_at)
    (strategy_id, requested_edit_sequence, semantic_hash, status)
    (delegated_authorization_id, requested_at)
  }

  checks {
    `requested_edit_sequence >= 0` [name: 'strategy_validation_edit_sequence_nonnegative']
    `issue_count >= 0` [name: 'strategy_validation_issue_count_nonnegative']
    `(status = 'RUNNING' AND completed_at IS NULL) OR (status <> 'RUNNING' AND completed_at IS NOT NULL)` [name: 'strategy_validation_completion_state_valid']
  }

  Note: 'Deterministic validation of one exact mutable Strategy document state. delegated_authorization_id identifies an external AI request; null means the account acted directly. Validation never releases a Strategy, launches a Bot, or starts a backtest.'

  Records (id, strategy_id, requested_by_account_id, delegated_authorization_id, requested_edit_sequence, semantic_hash, element_catalog_version_id, status, issue_count, result_document, requested_at, completed_at) {
    '00000000-0000-4000-8000-000000000014', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, 1, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '00000000-0000-4000-8000-000000000001', 'VALID', 0, '{"issues":[]}', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:01+09:00'
  }
}

