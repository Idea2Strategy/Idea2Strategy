Table identity.delegated_authorizations {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null]
  client_label varchar(120) [not null]
  external_provider_code varchar(80)
  status identity.delegated_authorization_status [not null]
  expiry_mode identity.delegated_expiry_mode [not null]
  auth_epoch_at_grant bigint [not null]
  disclosure_policy_document_id uuid [not null]
  scope_set_hash varchar(128) [not null]
  authorized_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  revoked_at timestamptz
  revoke_reason_code varchar(80)

  indexes {
    (account_id, status, authorized_at)
    (status, expires_at)
  }

  checks {
    `auth_epoch_at_grant > 0` [name: 'delegated_authorization_auth_epoch_positive']
    `(expiry_mode = 'AT_TIME' AND expires_at IS NOT NULL) OR (expiry_mode <> 'AT_TIME' AND expires_at IS NULL)` [name: 'delegated_authorization_expiry_mode_valid']
    `(status = 'REVOKED' AND revoked_at IS NOT NULL) OR (status <> 'REVOKED' AND revoked_at IS NULL)` [name: 'delegated_authorization_revocation_state_valid']
  }

  Note: 'User-approved external AI/tool delegation. The delegate is never the account owner or final approver. A mismatched account auth epoch, sanction, expiry, or revocation blocks every new call without affecting committed server work or running bots.'

  Records (id, account_id, client_label, external_provider_code, status, expiry_mode, auth_epoch_at_grant, disclosure_policy_document_id, scope_set_hash, authorized_at, expires_at, revoked_at, revoke_reason_code) {
    '00000000-0000-4000-8000-000000000011', '00000000-0000-4000-8000-000000000001', 'Review AI Tool', 'REVIEW_EXAMPLE', 'ACTIVE', 'AT_TIME', 1, '00000000-0000-4000-8000-000000000001', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', null, null
  }
}

