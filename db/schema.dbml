Table competition.backtest_evaluation_plans {
  room_id uuid [pk]
  plan_version varchar(40) [not null]
  period_count int [not null]
  plan_hash varchar(128) [not null, unique]
  commitment_hash varchar(128) [not null, unique]
  commitment_nonce_ciphertext text [not null]
  nonce_key_version smallint [not null]
  locked_at timestamptz [not null]
  disclosed_at timestamptz

  checks {
    `period_count >= 2` [name: 'competition_backtest_period_count_minimum']
    `nonce_key_version > 0` [name: 'competition_backtest_nonce_key_version_positive']
    `disclosed_at IS NULL OR disclosed_at >= locked_at` [name: 'competition_backtest_plan_disclosure_order']
  }

  Note: '플랫폼 공식 BACKTEST Room의 1:1 불변 비공개 평가 계획. 초기 자금·수수료·슬리피지·채점 공식은 room_rules로 항상 공개하고, 실제 기간·가중치·Dataset Manifest는 ENDED 전까지 권한 분리한다. 잠금 시 비밀 nonce를 포함한 commitment_hash만 공개하고 ENDED 뒤 계획과 nonce를 공개해 중간 변경이 없었음을 검증한다. nonce 평문은 저장하지 않는다.'

  Records (room_id, plan_version, period_count, plan_hash, commitment_hash, commitment_nonce_ciphertext, nonce_key_version, locked_at, disclosed_at) {
    '00000000-0000-4000-8000-000000000001', '1.0.0', 2, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', 'kms:v1:encrypted-review-nonce', 1, '2026-07-01T09:00:00+09:00', null
  }
}

Table competition.backtest_evaluation_periods {
  id uuid [pk, default: `gen_random_uuid()`]
  evaluation_plan_room_id uuid [not null]
  period_sequence int [not null]
  evaluation_start date [not null]
  evaluation_end date [not null]
  importance_weight numeric(18,12) [not null]
  input_set_hash varchar(128) [not null]

  indexes {
    (evaluation_plan_room_id, period_sequence) [unique]
    (evaluation_plan_room_id, evaluation_start, evaluation_end) [unique]
  }

  checks {
    `period_sequence >= 1` [name: 'competition_backtest_period_sequence_positive']
    `evaluation_end >= evaluation_start` [name: 'competition_backtest_period_order']
    `importance_weight > 0 AND importance_weight <= 1` [name: 'competition_backtest_period_weight_range']
  }

  Note: '서로 독립 초기 상태로 실행하는 숨은 기간. 같은 계획의 기간 범위 비중복, 행 수 = period_count, importance_weight 합계 = 1은 잠금 시 PostgreSQL deferred trigger와 daterange exclusion constraint로 강제한다. 기간 길이로 자동 가중하지 않고 플랫폼이 시장 중요도를 직접 설정한다.'

  Records (id, evaluation_plan_room_id, period_sequence, evaluation_start, evaluation_end, importance_weight, input_set_hash) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, '2020-02-01', '2020-04-30', 0.600000000000, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
    '00000000-0000-4000-8000-000000000002', '00000000-0000-4000-8000-000000000001', 2, '2022-01-01', '2022-06-30', 0.400000000000, 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
  }
}

