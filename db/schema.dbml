  Records (id, feed_id, instrument_id, data_layer, resolution, revision_number, status, period_start, period_end, schema_version, dataset_hash, supersedes_manifest_id, created_at, available_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '1m', 1, 'AVAILABLE', '2026-07-27T09:00:00+09:00', '2026-07-27T16:00:00+09:00', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '00000000-0000-4000-8000-000000000001', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table market_data.dataset_objects {
  id uuid [pk, default: `gen_random_uuid()`]
  dataset_manifest_id uuid [not null]
  object_id uuid [not null]
  object_kind varchar(40) [not null]
  partition_granularity market_data.partition_granularity [not null]
  partition_start date [not null, note: 'ET 달력 기준 포함 시작일.']
  partition_end date [not null, note: 'ET 달력 기준 미포함 종료일.']
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  shard_key varchar(120) [not null]
  part_number int [not null]
  row_count bigint [not null]
  min_instrument_id uuid
  max_instrument_id uuid

  indexes {
    (dataset_manifest_id, object_kind, partition_granularity, partition_start, partition_end, shard_key, part_number) [unique]
    (partition_granularity, partition_start, partition_end)
    (dataset_manifest_id, period_start, period_end)
  }

  checks {
    `partition_end > partition_start` [name: 'dataset_object_partition_order']
    `period_end > period_start` [name: 'dataset_object_period_order']
  }

  Note: '오브젝트는 ET 기준 일·주·월·연 파티션을 지원한다. 주 경계는 월요일, 월 경계는 매월 1일, 연 경계는 1월 1일이며 partition_end는 미포함이다. 마이크로배치나 작은 파티션을 더 큰 파티션으로 컴팩션할 때 원본을 덮어쓰지 않고 새 오브젝트·새 데이터셋 리비전·명시적 오브젝트 계보를 만든다. 하나의 공개 Manifest는 같은 shard와 시간 범위에 겹치는 표현을 동시에 포함하지 않는다.'

  Records (id, dataset_manifest_id, object_id, object_kind, partition_granularity, partition_start, partition_end, period_start, period_end, shard_key, part_number, row_count, min_instrument_id, max_instrument_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'WEEK', '2026-07-27', '2026-08-03', '2026-07-27T09:00:00+09:00', '2026-07-31T16:00:00+09:00', 'REVIEW_EXAMPLE', 1, 1, null, null
  }
}

