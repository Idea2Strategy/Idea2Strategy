  last_ingested_at timestamptz [not null]
  last_sequence bigint
  updated_at timestamptz [not null]

  Note: '재구축 가능한 시장 데이터 신선도 Projection(market_data 소유, 실시간 피드당 1행). 평가 전 실행 게이트가 quality_incidents와 함께 읽어 시장 데이터 평가 진행 여부를 결정. 전역 지연·장애는 여기와 operations 관측성에만 존재하며 봇 행을 대량 갱신하지 않는다. 컨슈머 lag, 유실 이벤트, outbox 적체는 같은 파이프라인 범위 문제이고 봇은 자신의 execution_blocked_at만 가진다.'

  Records (feed_id, last_source_event_at, last_ingested_at, last_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 1, '2026-07-27T09:00:00+09:00'
  }
}

// -----------------------------------------------------------------------------
// bot: independent immutable execution snapshots with mutable presentation.
// -----------------------------------------------------------------------------

Table bot.bots {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_account_id uuid [not null]
  mode strategy.strategy_mode [not null]
  name varchar(120) [not null]
  lifecycle_status bot.lifecycle_status [not null]
  lifecycle_changed_at timestamptz [not null]
  execution_blocked_at timestamptz [note: 'nullable 실행 차단 Projection. NULL이면 정상. 이 봇에만 국한된 손상(런타임 상태 손상, 이벤트 시퀀스 갭, 예약·원장 불일치, 정산 실패, 복구 불가 Element 평가 오류)에서만 설정.']
  execution_block_reason_code varchar(80)
  execution_block_event_id uuid
  created_at timestamptz [not null, default: `now()`]
  execution_eligible_from timestamptz [not null]
  started_at timestamptz
  stop_requested_at timestamptz
  stopped_at timestamptz
  stop_reason_code varchar(80)
  archived_at timestamptz
  deleted_at timestamptz
  edit_sequence bigint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_account_id, lifecycle_status, created_at)
    (lifecycle_status, execution_blocked_at, created_at)
    (lifecycle_status, execution_eligible_from, created_at)
    (owner_account_id, deleted_at, archived_at, created_at)
  }

  checks {
    `execution_blocked_at IS NOT NULL OR (execution_block_reason_code IS NULL AND execution_block_event_id IS NULL)` [name: 'bot_block_fields_together']
    `started_at IS NULL OR started_at >= execution_eligible_from` [name: 'bot_actual_start_after_eligibility']
  }

  Note: '검증된 Strategy 당시 상태를 복사해 생성한 완전 독립 실행 Bot. 원본 Strategy 식별자·출처·계보·버전 관계를 저장하지 않아 어느 Strategy에서 출시됐는지 조회할 수 없다. 출시된 실행 의미와 mode는 불변이고 Bot 이름, 파티션·Flow 설명과 좌표 및 Flow 내부 layout 같은 presentation만 수정 가능하다. RUNNING이어도 now()가 execution_eligible_from보다 이르면 평가하지 않으며 별도 waiting·scheduled 상태는 만들지 않는다. 개인 Bot은 즉시, 평가 전에 생성된 대회 Bot은 대회 평가 시작부터 실행 가능하고, 이미 진행 중인 공식 BACKTEST 대회 Bot은 입력 잠금 완료 뒤 Competition 백테스트 실행기로만 보낸다. Competition 관계가 BACKTEST인 Bot은 라이브 Trigger Router가 절대 평가하지 않는다. started_at은 실제 첫 실행이 시작될 때만 설정한다. STOPPING은 신규 평가·신규 주문 등록만 막고 기존 미체결 주문을 취소하지 않은 채 결과·예약 해제·정산을 마무리하며 STOPPED는 영구다. 파티션 1개 이상과 각 파티션의 완성 Flow 1개 이상을 검증한 뒤 Bot 스냅샷 계층을 원자적으로 생성한다. archived_at은 STOPPED Bot의 가역 숨김이고 deleted_at은 정산 완료 뒤의 논리 삭제다.'

  Records (id, owner_account_id, mode, name, lifecycle_status, lifecycle_changed_at, execution_blocked_at, execution_block_reason_code, execution_block_event_id, created_at, execution_eligible_from, started_at, stop_requested_at, stopped_at, stop_reason_code, archived_at, deleted_at, edit_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'BASIC', 'Official Backtest Bot', 'RUNNING', '2026-07-28T10:00:00+09:00', null, null, null, '2026-07-28T10:00:00+09:00', '2026-07-28T10:00:00+09:00', '2026-07-28T10:00:01+09:00', null, null, null, null, null, 0, '2026-07-28T10:00:00+09:00'
  }
}

Table bot.continuation_deadlines {
  bot_id uuid [pk]
  due_at timestamptz [not null]
  last_renewed_at timestamptz
  renewal_sequence bigint [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (due_at)
  }

  checks {
    `last_renewed_at IS NULL OR due_at > last_renewed_at` [name: 'bot_continuation_due_after_renewal']
    `renewal_sequence >= 0` [name: 'bot_continuation_sequence_nonnegative']
  }

  Note: '무소속 실행 봇의 명시적 계속 실행 확인 기한. 조회와 로그인은 이 행을 변경하지 않는다.'
}

Table bot.launch_snapshots {
  bot_id uuid [pk]
  snapshot_schema_version varchar(40) [not null]
  semantic_snapshot jsonb [not null, note: '출시 시점의 mode, 파티션 예산 상한, Flow, Element, edge, 매개변수, 선택 종목 및 실행 규칙을 포함한다. Strategy 식별자나 출처 정보는 포함할 수 없다.']
  presentation_snapshot jsonb [not null, note: '출시 시점의 이름·설명·파티션·Flow·Element 배치를 보존한다. 출시 후 현재 presentation은 수정될 수 있지만 이 증적은 불변이다.']
  semantic_hash varchar(128) [not null]
  presentation_hash varchar(128) [not null]
  snapshot_hash varchar(128) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (semantic_hash)
    (snapshot_hash)
  }

  Note: 'Bot 출시 당시 상태의 불변 1:1 증적. 정규화된 bot_partitions·flows·의존성·launch_configurations와 같은 트랜잭션에서 생성하며 snapshot_hash는 의미 스냅샷과 launch configuration을 함께 바인딩한다. 동일 Strategy에서 여러 번 출시해도 각 Bot은 독립 스냅샷만 가지며 원본 Strategy를 역추적할 수 없다. 현재 좌표·레이아웃 수정은 presentation_snapshot을 덮어쓰지 않는다.'

  Records (bot_id, snapshot_schema_version, semantic_snapshot, presentation_snapshot, semantic_hash, presentation_hash, snapshot_hash, created_at) {
    '00000000-0000-4000-8000-000000000001', '1.0.0', '{"mode":"BASIC","partitions":[{"key":"partition-1","budgetCapBps":5000,"flows":[{"key":"flow-1","elements":[],"edges":[],"instrumentIds":[]}]}]}', '{"bot":{"name":"Review Example"},"partitions":{"partition-1":{"x":100,"y":100}},"flows":{"flow-1":{"x":300,"y":100}},"elements":{}}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.launch_configurations {
  bot_id uuid [pk]
  initial_cash_amount numeric(24,8) [not null]
  currency_code char(3) [not null, default: 'USD']
  broker_rules_version varchar(80) [not null]
  accounting_rules_version varchar(80) [not null]
  precision_rules_version varchar(80) [not null]
  fee_policy_id uuid [not null]
  slippage_rate_bps int [not null, note: '고정 5 bps. 매수는 +, 매도는 -.']
  buying_power_buffer_policy_id uuid [not null]
  candidate_conflict_policy jsonb [not null]
  configuration_hash varchar(128) [not null]

  checks {
    `initial_cash_amount > 0` [name: 'launch_initial_cash_positive']
    `slippage_rate_bps = 5` [name: 'launch_fixed_slippage_five_bps']
  }

  Note: 'bot.launch_snapshots·파티션·완성 Flow와 원자적으로 삽입. 초기 가상 자본은 양수 USD, 봇별 격리이며 입금·출금·증액 불가. 사용자 정의 위험 통제는 Flow의 RISK_POLICY Element에만 존재. 실행 설정은 생성 시점부터 불변이며 의미 변경·삭제는 항상 거부.'

  Records (bot_id, initial_cash_amount, currency_code, broker_rules_version, accounting_rules_version, precision_rules_version, fee_policy_id, slippage_rate_bps, buying_power_buffer_policy_id, candidate_conflict_policy, configuration_hash) {
    '00000000-0000-4000-8000-000000000001', 100000.00000000, 'USD', '1.0.0', '1.0.0', '1.0.0', '00000000-0000-4000-8000-000000000001', 5, '00000000-0000-4000-8000-000000000001', '{"sameInstrumentOpposite":"NET","tieBreaker":"PARTITION_POSITION","budgetOverflow":"REDUCE"}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
  }
}

Table bot.bot_partitions {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  name varchar(120) [not null]
  description text
  budget_cap_bps int [not null, note: '봇 초기 자본의 0..10000 bps. 형제 합은 10000 이하.']
  position_x numeric(14,4) [not null]
  position_y numeric(14,4) [not null]
  configuration_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bot_id, position_y, position_x, id)
    (bot_id, id) [unique]
  }


  checks {
    `budget_cap_bps > 0 AND budget_cap_bps <= 10000` [name: 'partition_budget_cap_range']
  }

  Note: '완성된 파티션은 최대 100%의 불변 양수 예산 상한과 1개 이상의 Flow를 소유하며, 형제 상한 합은 지연 집계 제약으로 100% 이하 검증. 종목이나 별도 위험 정책 문서는 소유하지 않는다. 파티션이 최하위 예산 경계라 자식 Flow들은 이 상한을 공유하고 개별 할당은 없다. 위험 통제는 각 Flow semantic_document의 RISK_POLICY Element. 형제 파티션 간 차입 금지. name, description, position_x, position_y는 configuration_hash에서 제외되는 편집 필드이고 좌표 겹침 허용, id는 결정적 조회 타이브레이커. edit_sequence는 0에서 시작해 편집 필드 갱신 성공마다 정확히 1 증가(낙관적 동시성), updated_at은 그 커밋 시각. (bot_id, id)는 복합 PK나 버전이 아닌 대체 소유 키. 복사/붙여넣기는 원본 참조 없는 독립 새 행과 자식을 생성.'

  Records (id, bot_id, name, description, budget_cap_bps, position_x, position_y, configuration_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'Review Example', 'Fictional review sample', 5000, 100000.00000000, 100000.00000000, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.flows {
  id uuid [pk, default: `gen_random_uuid()`]
  partition_id uuid [not null]
  name varchar(120) [not null]
  description text
  element_catalog_version_id uuid [not null]
  compiled_flow_plan_id uuid [not null]
  position_x numeric(14,4) [not null]
  position_y numeric(14,4) [not null]
  semantic_document jsonb [not null]
  layout_document jsonb [not null, note: '요소별 좌표·크기, 그룹 배치·접힘, 선택 상태, edge routing hint, viewport와 zoom을 저장하는 UI 전용 문서. 요소 키와 엣지 키는 semantic_document의 안정 식별자를 참조해야 한다.']
  layout_schema_version varchar(40) [not null]
  semantic_hash varchar(128) [not null]
  layout_hash varchar(128) [not null]
  configuration_hash varchar(128) [not null]
  edit_sequence bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (partition_id, position_y, position_x, id)
    (partition_id, id) [unique]
    (semantic_hash)
  }

  Note: 'Flow는 정확히 하나의 파티션이 소유하는 완결 Element 그래프이며 재사용 라이브러리 항목이나 버전 엔티티가 아니다. BASIC/PRO 모드는 봇에서 상속. 예산 할당 경계는 파티션뿐이고 런타임 행의 flow_id는 귀속 기록용. 매수·매도 Element의 주문 규모 단위는 퍼센트이며 semantic_document에 orderSizePercent(0 초과 100 이하)와 minReactivationIntervalSeconds(0 이상)를 고정한다. 매수는 실행 시점 Partition 가용 현금, 매도는 해당 Flow의 예약되지 않은 매도 가능 수량에 퍼센트를 적용한다. name, description, position_x, position_y, layout_document와 layout_schema_version은 semantic_hash·configuration_hash에서 제외되는 편집 필드, 좌표 겹침 허용, id는 결정적 조회 타이브레이커. edit_sequence는 0에서 시작해 이름·설명·좌표·레이아웃 같은 편집 필드 갱신 성공마다 정확히 1 증가, updated_at은 그 커밋 시각. Element·포트·안정 키를 가진 엣지·매개변수·의미 그룹·RISK_POLICY Element는 semantic_document 하나의 불변 실행 의미 JSONB 집합체다. layout_document는 같은 안정 Element·엣지 키를 참조하는 UI 전용 JSONB이며 layout_schema_version으로 해석 규칙을 선택하고 layout_hash로 무결성을 확인한다. 레이아웃 변경은 실행 계획, 의미 검증, 백테스트 또는 configuration_hash를 변경하지 않는다. configuration_hash는 Element 카탈로그 버전과 semantic_hash만 바인딩. (partition_id, id)는 복합 런타임 FK용 대체 소유 키. 복사/붙여넣기는 원본 참조 없는 독립 새 행 생성.'

  Records (id, partition_id, name, description, element_catalog_version_id, compiled_flow_plan_id, position_x, position_y, semantic_document, layout_document, layout_schema_version, semantic_hash, layout_hash, configuration_hash, edit_sequence, created_at, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'Review Example', 'Fictional review sample', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 100000.00000000, 100000.00000000, '{"elements":[{"key":"data-1","type":"PRICE_DATA","params":{"resolution":"1m"}},{"key":"ind-1","type":"RSI","params":{"period":14}},{"key":"cond-1","type":"THRESHOLD","params":{"operator":"LT","value":30}},{"key":"order-1","type":"MARKET_BUY","params":{"orderSizePercent":40,"minReactivationIntervalSeconds":1800}},{"key":"risk-1","type":"RISK_POLICY","params":{"maxPositionBps":5000}}],"edges":[{"key":"edge-1","from":"data-1.series","to":"ind-1.input"},{"key":"edge-2","from":"ind-1.value","to":"cond-1.input"},{"key":"edge-3","from":"cond-1.true","to":"order-1.trigger"}]}', '{"schemaVersion":"1.0.0","elements":{"data-1":{"x":80,"y":120,"width":180,"height":96},"ind-1":{"x":340,"y":120,"width":180,"height":96},"cond-1":{"x":600,"y":120,"width":180,"height":120},"order-1":{"x":860,"y":80,"width":180,"height":96},"risk-1":{"x":860,"y":260,"width":180,"height":96}},"edgeRoutes":{"edge-3":{"waypoints":[{"x":820,"y":180}]}},"groups":{},"viewport":{"x":0,"y":0,"zoom":1.0},"selectedElementKeys":[]}', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

Table bot.flow_instruments {
  flow_id uuid [not null]
  instrument_id uuid [not null]

  indexes {
    (flow_id, instrument_id) [pk]
  }

  Note: '완성된 Flow semantic_document가 요구하는 명시적 종목의 불변 집합. 종목의 매매/참조 역할은 그 문서의 타입 Element과 엣지로 한 번 정의되며 여기에 가변 역할로 중복 저장하지 않는다. Flow와 원자적으로 삽입. 시작 검증은 종목 1개 이상과 추출된 의존성-행의 정확한 일치를 요구. 향후 유니버스 선택은 현재 범위 밖이며 제품 지원 시 별도 검토된 모델·마이그레이션으로 도입해야 한다.'

  Records (flow_id, instrument_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.flow_feature_requirements {
  flow_id uuid [not null]
  instrument_id uuid [not null]
  feature_definition_id uuid [not null]

  indexes {
    (flow_id, instrument_id, feature_definition_id) [pk]
    (feature_definition_id, instrument_id, flow_id)
  }

  Note: '완성 시 Flow semantic_document에서 추출한 불변 의존성 집합. 사용자 작성 상태가 아니며 예산도 부여하지 않는다. 역방향 인덱스로 서버가 동일 피처·종목 기준으로 활성 Flow을 묶어 공통 계산을 한 번 수행하고 여러 봇 평가로 팬아웃.'

  Records (flow_id, instrument_id, feature_definition_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.bot_events {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  event_sequence bigint [not null]
  event_type varchar(80) [not null]
  event_schema_version varchar(40) [not null]
  causation_event_id uuid
  correlation_id uuid [not null]
  idempotency_key varchar(160) [not null]
  occurred_at timestamptz [not null]
  received_at timestamptz [not null]
  committed_at timestamptz [not null, default: `now()`]
  summary_document jsonb [not null]
  market_dataset_manifest_id uuid
  evidence_object_id uuid

  indexes {
    (bot_id, event_sequence) [unique]
    (bot_id, id) [unique]
    (bot_id, idempotency_key) [unique]
    (event_type, committed_at)
    (correlation_id)
  }

  Note: '봇별 추가 전용 순서 보장 공식 스트림이자 라우팅된 트리거 이벤트의 유일한 봇별 구체화. Trigger Router가 전역 이벤트 식별자를 담은 결정적 idempotency_key(예: PRICE:AAPL:bar-close-timestamp, SCHEDULE:ONE_MINUTE:minute)로 라우팅 이벤트당 1행을 적재하므로 (bot_id, idempotency_key)가 별도 전역 트리거 테이블 없이 at-least-once 재전달을 흡수. event_sequence는 런타임 감사 순서이지 봇 버전이 아니며 갭 허용. 실행 차단 생명주기는 문서화된 이벤트 타입 BOT_EXECUTION_BLOCKED, BOT_EXECUTION_UNBLOCKED, SETTLEMENT_FAILED, LEDGER_INVARIANT_VIOLATED, STATE_REBUILD_COMPLETED 사용. 의사결정에 쓴 정확한 시장 관측치는 값/버전/해시로 고정.'

  Records (id, bot_id, event_sequence, event_type, event_schema_version, causation_event_id, correlation_id, idempotency_key, occurred_at, received_at, committed_at, summary_document, market_dataset_manifest_id, evidence_object_id) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 'REVIEW_EXAMPLE', '1.0.0', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '{"trigger":"PRICE","symbol":"AAPL","barClosedAt":"2026-07-24T10:00:00-04:00"}', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001'
  }
}

Table bot.flow_time_triggers {
  flow_id uuid [not null]
  trigger_type bot.time_trigger_type [not null]
  schedule_key varchar(40) [not null, note: '값은 SCHEDULE이면 ONE_MINUTE 같은 Interval 키, 세션 트리거면 고정값 NONE.']

  indexes {
    (flow_id, trigger_type, schedule_key) [pk]
    (trigger_type, schedule_key, flow_id)
  }

  Note: '완성된 Flow semantic_document에서 서버가 추출한 시간·세션 트리거 의존성 Projection. 사용자 작성이 아니고 제2의 정본도 아니다. 종목·피처 트리거 의존성은 flow_instruments와 flow_feature_requirements에 유지(중복 테이블 없음). 역방향 인덱스가 Trigger Router 조회에 답한다: MARKET_OPEN이나 ONE_MINUTE 이벤트는 구독한 Flow만 찾아 RUNNING 비차단 봇과 조인하며, 시장 전체 이벤트가 전체 봇을 스캔하지 않는다.'

  Records (flow_id, trigger_type, schedule_key) {
    '00000000-0000-4000-8000-000000000001', 'SCHEDULE', 'ONE_MINUTE'
  }
}

Table bot.evaluation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  trigger_event_id uuid [not null]
  result_event_id uuid [unique]
  feature_snapshot_batch_id uuid
  feature_snapshot_key varchar(200)
  feature_snapshot_hash varchar(128)
  status operations.work_status [not null]
  attempt_count int [not null, default: 0]
  lease_expires_at timestamptz [note: 'at-least-once 인계용 워커 lease. 만료되면 다른 공용 워커가 이어서 수행.']
  input_state_hash varchar(128)
  input_market_hash varchar(128) [note: '스냅샷이 고정된 경우 참조한 공유 피처 스냅샷 입력 해시와 같아야 한다.']
  candidate_set_hash varchar(128)
  candidate_count int
  state_change_count int
  result_hash varchar(128)
  summary_document jsonb
  queued_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
  failure_code varchar(80)

  indexes {
    (trigger_event_id, flow_id) [unique]
    (bot_id, id) [unique]
    (flow_id, queued_at)
    (bot_id, queued_at)
    (status, lease_expires_at)
    (feature_snapshot_batch_id, feature_snapshot_key)
  }

  checks {
    `attempt_count >= 0` [name: 'evaluation_attempt_count_nonnegative']
    `status <> 'SUCCEEDED' OR (completed_at IS NOT NULL AND result_hash IS NOT NULL)` [name: 'evaluation_success_complete']
  }

  Note: '트리거 이벤트당 Flow당 1행: 평가 큐, 사용자 노출 판단 로그, idempotency의 단위. 유일한 (trigger_event_id, flow_id) 쌍이 상류 bot_events와 하류 파티션별 order_intent_batches를 이어 at-least-once 재전달을 안전하게 만든다. 같은 파티션 Flow 평가는 병렬 가능하지만 예산·보유수량·충돌·상계 적용은 (bot_id, partition_id) advisory transaction lock과 파티션 Projection 행 잠금 아래 직렬화한다. 시장 데이터 평가는 불변 공유 피처 스냅샷을 고정하고 공통 지표를 봇별 재계산하지 않는다.'

  Records (id, bot_id, partition_id, flow_id, trigger_event_id, result_event_id, feature_snapshot_batch_id, feature_snapshot_key, feature_snapshot_hash, status, attempt_count, lease_expires_at, input_state_hash, input_market_hash, candidate_set_hash, candidate_count, state_change_count, result_hash, summary_document, queued_at, started_at, completed_at, failure_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'SUCCEEDED', 1, '2026-07-27T09:01:00+09:00', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 1, 1, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '{"decision":"ORDER_INTENT","firstFailedCondition":null,"notes":"RSI 28.4 < 30"}', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE'
  }
}

Table bot.runtime_state_values {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  instrument_id uuid
  element_instance_key varchar(160) [not null]
  state_definition_key varchar(160) [not null]
  value_type bot.runtime_value_type [not null]
  current_value jsonb [not null]
  last_event_sequence bigint [not null]
  updated_at timestamptz [not null]

  indexes {
    (bot_id, id) [unique]
    (bot_id, partition_id, flow_id, element_instance_key, state_definition_key, instrument_id) [unique]
    (bot_id, last_event_sequence)
  }

  Note: '평가 간 유지가 필요한 공식 봇 전용 Flow 상태만 PostgreSQL이 소유. 주문 Element의 LAST_SUCCESSFUL_FILL_AT 상태는 마지막 정상 개별 Fill 시각을 저장하며, 현재 시각이 이 값과 minReactivationIntervalSeconds를 지난 경우에만 같은 Element가 새 Intent를 만들 수 있다. 거절·만료와 미체결 Order 생성은 이 값을 갱신하지 않는다. 명시적 봇/파티션/Flow 소유가 봇 간 누출을 방지하고, instrument_id는 Flow 전역 상태에서만 null. 공유 가격·캔들·지표·캘린더·피처 값은 여기 금지이며 market_data 공유 계산이나 일회성 캐시 소관. instrument_id의 null-safe 유일성은 마이그레이션에서 강제.'

  Records (id, bot_id, partition_id, flow_id, instrument_id, element_instance_key, state_definition_key, value_type, current_value, last_event_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'REVIEW_EXAMPLE', 'DECIMAL', '{"value":28.4}', 1, '2026-07-27T09:00:00+09:00'
  }
}

Table bot.runtime_state_changes {
  bot_id uuid [not null]
  bot_event_id uuid [not null]
  runtime_state_value_id uuid [not null]
  previous_value_hash varchar(128) [note: '상태 키 최초 생성 시에만 null.']
  new_value jsonb [not null]
  new_value_hash varchar(128) [not null]
  change_reason_code varchar(80) [not null]

  indexes {
    (bot_event_id, runtime_state_value_id) [pk]
  }

  Note: '봇 전용 상태 변경의 추가 전용 before/after 증적. bot_id가 두 복합 참조에 모두 포함되어 이벤트가 다른 봇 소유 상태 행을 변경할 수 없다.'

  Records (bot_id, bot_event_id, runtime_state_value_id, previous_value_hash, new_value, new_value_hash, change_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, '{"value":28.4}', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'REVIEW_EXAMPLE'
  }
}

// -----------------------------------------------------------------------------
// trading: intents, netting, reservations, orders, fills, ledgers, and lots.
// -----------------------------------------------------------------------------

Table trading.buying_power_buffer_policy_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  policy_code varchar(80) [not null]
  version varchar(40) [not null]
  buffer_bps int [not null]
  rounding_rules_version varchar(40) [not null]
  rules_hash varchar(128) [not null, unique]
  effective_from timestamptz [not null]
  effective_to timestamptz
  published_at timestamptz [not null]

  checks {
    `buffer_bps >= 0` [name: 'buying_power_buffer_bps_nonnegative']
    `effective_to IS NULL OR effective_to > effective_from` [name: 'buying_power_buffer_effective_range']
  }

  indexes {
    (policy_code, version) [unique]
    (policy_code, effective_from)
  }

  Note: '플랫폼 관리 불변 정책. 정확한 buffer_bps는 운영 전 근거 필요.'

  Records (id, policy_code, version, buffer_bps, rounding_rules_version, rules_hash, effective_from, effective_to, published_at) {
    '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '1.0.0', 1, '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '2026-07-27T09:00:00+09:00', null, '2026-07-27T09:00:00+09:00'
  }
}

Table trading.fee_policy_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  policy_code varchar(80) [not null]
  version varchar(40) [not null]
  fee_rate_bps int [not null, note: '공식 통합 가상 거래 수수료 0.2% = 20 bps.']
  calculation_rules_version varchar(40) [not null]
  rules_hash varchar(128) [not null, unique]
  effective_from timestamptz [not null]
  effective_to timestamptz
  published_at timestamptz [not null]

  indexes {
    (policy_code, version) [unique]
    (policy_code, effective_from)
  }

  checks {
    `fee_rate_bps = 20` [name: 'official_fee_twenty_bps']
    `effective_to IS NULL OR effective_to > effective_from` [name: 'fee_policy_effective_range']
  }

  Note: '모든 롱·숏 매수·매도의 각 정상 개별 Fill에 동일하게 적용하는 불변 플랫폼 정책. 사용자가 변경할 수 없고 과거 체결은 당시 policy id를 고정한다.'

  Records (id, policy_code, version, fee_rate_bps, calculation_rules_version, rules_hash, effective_from, effective_to, published_at) {
    '00000000-0000-4000-8000-000000000001', 'OFFICIAL_SIMULATION_FEE', '1.0.0', 20, '1.0.0', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', '2026-07-28T09:00:00+09:00', null, '2026-07-28T09:00:00+09:00'
  }
}

Table trading.short_risk_policy_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  policy_code varchar(80) [not null]
  version varchar(40) [not null]
  rules_document jsonb [not null]
  rules_hash varchar(128) [not null, unique]
  effective_from timestamptz [not null]
  effective_to timestamptz
  published_at timestamptz [not null]

  indexes {
    (policy_code, version) [unique]
    (policy_code, effective_from)
  }

  checks {
    `effective_to IS NULL OR effective_to > effective_from` [name: 'short_risk_policy_effective_range']
  }

  Note: '가상 SHORT 포지션의 최초·유지 담보, 최대 노출·손실, Regulation SHO Rule 201 가격 제한과 시스템 청산 기준을 고정하는 불변 플랫폼 버전. 실제 주식 차입, 대여 가능 수량과 대여기관 회수는 모델링하지 않는다. 미결정 수치는 rules_document의 승인된 새 버전으로만 도입한다.'
}

Table trading.short_borrow_fee_policy_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  policy_code varchar(80) [not null]
  version varchar(40) [not null]
  annual_fee_rate_bps numeric(12,6) [not null]
  day_count_basis varchar(20) [not null, note: 'ACT_365 등 승인된 연환산 기준.']
  calculation_rules_version varchar(80) [not null]
  rules_hash varchar(128) [not null, unique]
  effective_from timestamptz [not null]
  effective_to timestamptz
  published_at timestamptz [not null]

  indexes {
    (policy_code, version) [unique]
    (policy_code, effective_from)
  }

  checks {
    `annual_fee_rate_bps >= 0` [name: 'short_borrow_fee_rate_nonnegative']
    `effective_to IS NULL OR effective_to > effective_from` [name: 'short_borrow_fee_policy_effective_range']
  }

  Note: '실제 대차시장의 변동 금리가 아니라 플랫폼이 모든 가상 SHORT lot에 일관되게 적용하는 고정 연간 보유 비용 정책. 정확한 bps는 승인된 정책 버전으로만 도입하고 과거 비용 계산은 당시 policy id를 고정한다.'
}

Table trading.order_intent_batches {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  source_event_id uuid [not null]
  status varchar(30) [not null]
  conflict_policy_hash varchar(128) [not null]
  composition_rules_version varchar(40) [not null]
  input_state_hash varchar(128) [not null]
  result_hash varchar(128)
  finalized_at timestamptz

  checks {
    `status IN ('COLLECTING', 'FINALIZED', 'FAILED')` [name: 'intent_batch_status_valid']
    `status <> 'FINALIZED' OR (finalized_at IS NOT NULL AND result_hash IS NOT NULL)` [name: 'intent_batch_finalized_complete']
  }

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, source_event_id) [unique]
    (bot_id, partition_id, finalized_at)
  }

  Note: '한 Bot Event에서 정확히 한 파티션의 Flow 의도만 수집하는 거래 격리 경계. 충돌 처리·상계·통합과 자원 잠금은 (bot_id, partition_id) 안에서만 수행한다. 복합 멱등 키가 같은 이벤트의 파티션별 at-least-once 재전달을 안전하게 흡수한다.'

  Records (id, bot_id, partition_id, source_event_id, status, conflict_policy_hash, composition_rules_version, input_state_hash, result_hash, finalized_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'FINALIZED', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '1.0.0', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb', '2026-07-28T09:00:00+09:00'
  }
}

Table trading.order_intents {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  batch_id uuid [not null]
  source_event_id uuid [not null]
  origin_type trading.intent_origin_type [not null]
  evaluation_run_id uuid [note: 'FLOW_EVALUATION에서만 필수. 시스템 강제 청산·강제 바이인은 평가 실행 없이 공식 사건에서 생성한다.']
  partition_id uuid [not null]
  flow_id uuid [not null]
  instrument_id uuid [not null]
  intent_key varchar(160) [not null]
  side trading.order_side [not null]
  position_effect trading.position_effect [not null]
  order_type trading.order_type [not null]
  time_in_force trading.time_in_force [not null]
  requested_quantity numeric(28,8)
  requested_notional numeric(24,8)
  approved_quantity numeric(28,8)
  approved_notional numeric(24,8)
  post_netting_quantity numeric(28,8) [not null, default: 0, note: '상계로 제거된 양이 아니라 상계 후 실제 주문 대상으로 남은 수량.']
  final_quantity numeric(28,8)
  final_notional numeric(24,8)
  limit_price numeric(24,8)
  stop_price numeric(24,8)
  trailing_offset_type trading.trailing_offset_type
  trailing_offset_value numeric(24,8)
  requested_expires_at timestamptz
  decision trading.intent_decision [not null]
  decision_reason_code varchar(80) [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (batch_id, intent_key) [unique]
    (bot_id, partition_id, batch_id, instrument_id, side)
    (partition_id, flow_id, instrument_id)
    (evaluation_run_id)
  }

  checks {
    `(requested_quantity IS NOT NULL) <> (requested_notional IS NOT NULL)` [name: 'intent_exactly_one_requested_measure']
    `requested_quantity IS NULL OR requested_quantity > 0` [name: 'intent_requested_quantity_positive']
    `requested_notional IS NULL OR requested_notional > 0` [name: 'intent_requested_notional_positive']
    `approved_quantity IS NULL OR approved_quantity >= 0` [name: 'intent_approved_quantity_nonnegative']
    `approved_notional IS NULL OR approved_notional >= 0` [name: 'intent_approved_notional_nonnegative']
    `post_netting_quantity >= 0` [name: 'intent_post_netting_quantity_nonnegative']
    `final_quantity IS NULL OR final_quantity >= 0` [name: 'intent_final_quantity_nonnegative']
    `final_notional IS NULL OR final_notional >= 0` [name: 'intent_final_notional_nonnegative']
    `origin_type <> 'FLOW_EVALUATION' OR evaluation_run_id IS NOT NULL` [name: 'flow_intent_requires_evaluation']
    `origin_type = 'FLOW_EVALUATION' OR evaluation_run_id IS NULL` [name: 'system_intent_has_no_evaluation']
    `order_type <> 'LIMIT' OR limit_price IS NOT NULL` [name: 'intent_limit_price_required']
    `order_type <> 'STOP' OR stop_price IS NOT NULL` [name: 'intent_stop_price_required']
    `order_type <> 'STOP_LIMIT' OR (limit_price IS NOT NULL AND stop_price IS NOT NULL)` [name: 'intent_stop_limit_prices_required']
    `order_type <> 'TRAILING_STOP' OR (trailing_offset_type IS NOT NULL AND trailing_offset_value > 0)` [name: 'intent_trailing_offset_required']
    `order_type = 'TRAILING_STOP' OR (trailing_offset_type IS NULL AND trailing_offset_value IS NULL)` [name: 'intent_non_trailing_has_no_offset']
    `order_type <> 'MARKET' OR (limit_price IS NULL AND stop_price IS NULL AND trailing_offset_type IS NULL AND time_in_force = 'DAY')` [name: 'intent_market_contract_valid']
    `time_in_force <> 'GTD' OR requested_expires_at IS NOT NULL` [name: 'intent_gtd_expiry_required']
    `(side = 'BUY' AND position_effect IN ('OPEN_LONG', 'CLOSE_SHORT')) OR (side = 'SELL' AND position_effect IN ('CLOSE_LONG', 'OPEN_SHORT'))` [name: 'intent_side_effect_compatible']
    `decision NOT IN ('REJECTED', 'NETTED', 'CONFLICTED') OR (COALESCE(final_quantity, 0) = 0 AND COALESCE(final_notional, 0) = 0)` [name: 'intent_nonexecuting_decision_has_no_final']
  }

  Note: 'Flow 또는 시스템 안전 절차가 만든 원래 의도와 승인·파티션 내부 상계·최종 잔여 결과의 불변 기록. Flow 주문 Element는 최소 재활성화 기간 경과와 동일 Element·종목의 OPEN Order/ACTIVE Reservation 부재를 먼저 검사한다. 매수 requested_notional은 실행 시점 Partition 가용 현금에 orderSizePercent를 적용한 상한이고, 매도 requested_quantity는 해당 Flow의 예약되지 않은 매도 가능 소수점 수량에 같은 퍼센트를 적용한 결과다. 같은 (bot_id, partition_id, batch_id)의 호환 가능한 종목·방향·주문 계약만 하나의 Order로 결합하며 다른 파티션이나 사용자와 절대 통합하지 않는다.'

  Records (id, bot_id, batch_id, source_event_id, origin_type, evaluation_run_id, partition_id, flow_id, instrument_id, intent_key, side, position_effect, order_type, time_in_force, requested_quantity, approved_quantity, post_netting_quantity, final_quantity, decision, decision_reason_code) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'FLOW_EVALUATION', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'P1:AAPL:BUY:FLOW_A', 'BUY', 'OPEN_LONG', 'MARKET', 'DAY', 3.12110526, 3.12110526, 3.12110526, 3.12110526, 'APPROVED', 'WITHIN_PARTITION_BUDGET'
  }
}

Table trading.orders {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  instrument_id uuid [not null]
  replaces_order_id uuid [unique]
  replacement_reason_code varchar(80)
  order_key varchar(160) [not null]
  side trading.order_side [not null]
  order_type trading.order_type [not null]
  time_in_force trading.time_in_force [not null]
  requested_quantity numeric(28,8) [not null]
  requested_notional numeric(24,8)
  limit_price numeric(24,8)
  stop_price numeric(24,8)
  trailing_offset_type trading.trailing_offset_type
  trailing_offset_value numeric(24,8)
  broker_rules_version varchar(80) [not null]
  precision_rules_version varchar(80) [not null]
  slippage_rate_bps int [not null]
  fee_policy_id uuid [not null]
  accepted_event_id uuid [not null]
  accepted_at timestamptz [not null]
  expires_at timestamptz
  contract_hash varchar(128) [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, order_key) [unique]
    (bot_id, partition_id, accepted_at)
    (partition_id, instrument_id, accepted_at)
    (bot_id, partition_id, contract_hash)
  }

  checks {
    `requested_quantity > 0` [name: 'order_requested_quantity_positive']
    `requested_notional IS NULL OR requested_notional > 0` [name: 'order_requested_notional_positive']
    `slippage_rate_bps = 5` [name: 'order_fixed_slippage_five_bps']
    `order_type <> 'LIMIT' OR limit_price IS NOT NULL` [name: 'order_limit_price_required']
    `order_type <> 'STOP' OR stop_price IS NOT NULL` [name: 'order_stop_price_required']
    `order_type <> 'STOP_LIMIT' OR (limit_price IS NOT NULL AND stop_price IS NOT NULL)` [name: 'order_stop_limit_prices_required']
    `order_type <> 'TRAILING_STOP' OR (trailing_offset_type IS NOT NULL AND trailing_offset_value > 0)` [name: 'order_trailing_offset_required']
    `order_type = 'TRAILING_STOP' OR (trailing_offset_type IS NULL AND trailing_offset_value IS NULL)` [name: 'order_non_trailing_has_no_offset']
    `order_type <> 'MARKET' OR (limit_price IS NULL AND stop_price IS NULL AND trailing_offset_type IS NULL AND time_in_force = 'DAY')` [name: 'order_market_contract_valid']
    `time_in_force <> 'GTD' OR expires_at IS NOT NULL` [name: 'order_gtd_expiry_required']
    `expires_at IS NULL OR expires_at > accepted_at` [name: 'order_expiry_after_acceptance']
    `expires_at IS NULL OR expires_at <= accepted_at + interval '90 days'` [name: 'order_expiry_within_ninety_days']
    `replaces_order_id IS NULL OR replaces_order_id <> id` [name: 'order_does_not_replace_itself']
    `(replaces_order_id IS NULL) = (replacement_reason_code IS NULL)` [name: 'order_replacement_reason_consistent']
  }

  Note: '파티션 내부 상계 후 제출되는 불변 파티션 전용 가상 주문 계약. 요청 수량은 접수 뒤 변경하지 않는다. CANCELLED는 사용자·봇 중지·운영자 조작으로 만들 수 없고, 이미 OPEN인 주문에 자동 replacement 정책을 적용할 때 원본을 철회하는 시스템 전이로만 사용한다. 더 작은 소수점 수량이 필요하면 원본 예약을 전액 해제하고 같은 파티션의 새 order component·reservation을 가진 replacement Order를 만든다. 현재 상태는 추가 전용 order_events와 projection에서만 얻는다.'

  Records (id, bot_id, partition_id, instrument_id, replaces_order_id, replacement_reason_code, order_key, side, order_type, time_in_force, requested_quantity, broker_rules_version, precision_rules_version, slippage_rate_bps, fee_policy_id, accepted_event_id, accepted_at, contract_hash) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, null, 'P1:AAPL:BUY:ORDER:1', 'BUY', 'MARKET', 'DAY', 3.12110526, '1.0.0', '1.0.0', 5, '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '2026-07-28T09:00:00+09:00', 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc'
  }
}

Table trading.order_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  group_type trading.order_group_type [not null]
  group_key varchar(160) [not null]
  status trading.order_group_status [not null]
  created_event_id uuid [not null]
  closed_event_id uuid

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, group_key) [unique]
  }

  Note: 'OCO·브래킷·Pro 연계 주문의 관계만 표현하는 파티션 전용 그룹. 다른 파티션 주문은 멤버가 될 수 없고 전량 체결 또는 미체결 결과만 처리한다.'
}

Table trading.order_group_members {
  bot_id uuid [not null]
  partition_id uuid [not null]
  order_group_id uuid [not null]
  order_id uuid [not null, unique]
  member_role trading.order_group_member_role [not null]
  leg_sequence int [not null]
  quantity_ratio numeric(18,8) [not null, default: 1]
  activation_condition jsonb [not null]
  cancellation_condition jsonb [not null]

  indexes {
    (order_group_id, order_id) [pk]
    (order_group_id, leg_sequence) [unique]
  }

  checks {
    `leg_sequence > 0` [name: 'order_group_leg_sequence_positive']
    `quantity_ratio > 0` [name: 'order_group_quantity_ratio_positive']
  }

  Note: 'OCO·브래킷·멀티레그에서 각 주문의 역할, 순서, 활성화와 상호 취소 조건을 고정한다. 주문 하나는 동시에 둘 이상의 그룹에 속하지 않는다.'
}

Table trading.order_group_events {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  order_group_id uuid [not null]
  bot_event_id uuid [not null, unique]
  group_sequence bigint [not null]
  previous_status trading.order_group_status
  new_status trading.order_group_status [not null]
  event_type varchar(50) [not null]
  reason_code varchar(80)
  occurred_at timestamptz [not null]
  event_document jsonb [not null]

  indexes {
    (order_group_id, group_sequence) [unique]
  }

  checks {
    `group_sequence > 0` [name: 'order_group_event_sequence_positive']
  }

  Note: '그룹의 활성화·상호 취소·완료·실패를 추가 전용으로 보존한다. order_groups.status는 이 이벤트의 현재 Projection이다.'
}

Table trading.order_components {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  order_id uuid [not null]
  intent_id uuid [not null]
  component_quantity numeric(28,8) [not null]
  component_notional numeric(24,8)
  component_sequence int [not null]
  composition_rules_version varchar(40) [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, order_id, id) [unique]
    (order_id, intent_id) [unique]
    (order_id, component_sequence) [unique]
    (intent_id)
  }

  checks {
    `component_quantity > 0` [name: 'order_component_quantity_positive']
    `component_notional IS NULL OR component_notional > 0` [name: 'order_component_notional_positive']
    `component_sequence > 0` [name: 'order_component_sequence_positive']
  }

  Note: '하나의 파티션 전용 Order를 구성하는 Flow별 주문 의도 내역. 각 행은 어떤 Intent가 최종 Order 수량 중 얼마를 구성하는지 고정하며, Order의 component_quantity 합계는 requested_quantity와 같아야 한다. 정확한 Intent·position_effect·구성 규칙 버전을 보존하고 합계 불변식은 PostgreSQL 지연 제약 트리거로 강제한다.'

  Records (id, bot_id, partition_id, order_id, intent_id, component_quantity, component_sequence, composition_rules_version) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 3.12110526, 1, '1.0.0'
  }
}

Table trading.resource_reservations {
  id uuid [pk, default: `gen_random_uuid()`]
  reservation_key varchar(200) [not null, note: '의도·자원종류·통화 또는 종목을 정규화한 null 없는 멱등 키.']
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  intent_id uuid [not null]
  resource_type trading.reservation_resource_type [not null]
  currency_code char(3)
  instrument_id uuid
  buffer_policy_id uuid
  fee_policy_id uuid
  short_risk_policy_id uuid
  precision_rules_version varchar(80) [not null]
  status trading.reservation_status [not null]
  reference_price numeric(24,8)
  reference_observed_at timestamptz
  reference_market_hash varchar(128)
  base_notional numeric(24,8)
  fixed_slippage_amount numeric(24,8)
  estimated_fee_amount numeric(24,8)
  buffer_amount numeric(24,8)
  reserved_amount numeric(24,8)
  consumed_amount numeric(24,8) [not null, default: 0]
  released_amount numeric(24,8) [not null, default: 0]
  reserved_quantity numeric(28,8)
  consumed_quantity numeric(28,8) [not null, default: 0]
  released_quantity numeric(28,8) [not null, default: 0]
  created_event_id uuid [not null]
  created_at timestamptz [not null]
  last_event_sequence bigint [not null, default: 1]

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, flow_id, id) [unique]
    (intent_id, reservation_key) [unique]
    (bot_id, partition_id, status, created_at)
    (partition_id, flow_id, status)
  }

  checks {
    `(reserved_amount IS NOT NULL) <> (reserved_quantity IS NOT NULL)` [name: 'reservation_exactly_one_measure']
    `reserved_amount IS NULL OR reserved_amount > 0` [name: 'reservation_amount_positive']
    `reserved_quantity IS NULL OR reserved_quantity > 0` [name: 'reservation_quantity_positive']
    `consumed_amount >= 0` [name: 'reservation_consumed_amount_nonnegative']
    `released_amount >= 0` [name: 'reservation_released_amount_nonnegative']
    `consumed_quantity >= 0` [name: 'reservation_consumed_quantity_nonnegative']
    `released_quantity >= 0` [name: 'reservation_released_quantity_nonnegative']
    `reserved_amount IS NULL OR consumed_amount + released_amount <= reserved_amount` [name: 'reservation_amount_not_exceeded']
    `reserved_quantity IS NULL OR consumed_quantity + released_quantity <= reserved_quantity` [name: 'reservation_quantity_not_exceeded']
    `reserved_amount IS NULL OR status = 'ACTIVE' OR consumed_amount + released_amount = reserved_amount` [name: 'reservation_amount_final_conservation']
    `reserved_quantity IS NULL OR status = 'ACTIVE' OR consumed_quantity + released_quantity = reserved_quantity` [name: 'reservation_quantity_final_conservation']
    `status <> 'ACTIVE' OR (released_amount = 0 AND released_quantity = 0)` [name: 'active_reservation_not_released']
    `status <> 'SETTLED' OR ((reserved_amount IS NOT NULL AND consumed_amount > 0) OR (reserved_quantity IS NOT NULL AND consumed_quantity > 0))` [name: 'settled_reservation_has_consumption']
    `status <> 'RELEASED' OR (consumed_amount = 0 AND consumed_quantity = 0)` [name: 'released_reservation_has_no_consumption']
    `resource_type <> 'CASH_BUYING_POWER' OR (currency_code IS NOT NULL AND buffer_policy_id IS NOT NULL AND fee_policy_id IS NOT NULL AND reserved_amount IS NOT NULL)` [name: 'cash_reservation_evidence_required']
    `resource_type <> 'POSITION_QUANTITY' OR (instrument_id IS NOT NULL AND reserved_quantity IS NOT NULL)` [name: 'quantity_reservation_instrument_required']
    `resource_type <> 'SHORT_COLLATERAL_CASH' OR (currency_code IS NOT NULL AND instrument_id IS NOT NULL AND reserved_amount IS NOT NULL)` [name: 'short_collateral_reservation_evidence_required']
    `resource_type = 'CASH_BUYING_POWER' OR (buffer_policy_id IS NULL AND fee_policy_id IS NULL AND buffer_amount IS NULL)` [name: 'cash_policies_only_for_buying_power']
    `resource_type <> 'SHORT_COLLATERAL_CASH' OR short_risk_policy_id IS NOT NULL` [name: 'short_collateral_policy_required']
    `resource_type = 'SHORT_COLLATERAL_CASH' OR short_risk_policy_id IS NULL` [name: 'short_policy_only_for_collateral']
  }

  Note: '파티션·Flow 주문 의도별 자원을 나타내는 mutable 현재 Projection. 부분 체결마다 소비량을 누적하는 동안 ACTIVE를 유지할 수 있으며 아직 소비되지 않은 잔여 예약은 후속 체결 또는 취소·만료·거절·replacement에 사용한다. 마지막 체결 또는 일부 소비 뒤 종료는 SETTLED로 전환하면서 실제 사용량을 보존하고 Buying Power 완충액·미사용 잔액을 해제한다. 한 번도 소비되지 않은 예약의 전액 해제만 RELEASED다. 최종 상태에서는 금액·수량 모두 consumed + released = reserved를 행 CHECK와 사건 합계 지연 트리거로 이중 강제한다.'

  Records (id, reservation_key, bot_id, partition_id, flow_id, intent_id, resource_type, currency_code, buffer_policy_id, fee_policy_id, precision_rules_version, status, reference_price, reference_observed_at, reference_market_hash, base_notional, fixed_slippage_amount, estimated_fee_amount, buffer_amount, reserved_amount, consumed_amount, released_amount, created_event_id, created_at, last_event_sequence) {
    '00000000-0000-4000-8000-000000000001', 'P1:FLOW_A:AAPL:CASH:1', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'CASH_BUYING_POWER', 'USD', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '1.0.0', 'SETTLED', 100.00000000, '2026-07-28T09:00:00+09:00', 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd', 312.11052600, 0.15605526, 0.62453316, 0.03128911, 312.92240353, 312.89111442, 0.03128911, '00000000-0000-4000-8000-000000000001', '2026-07-28T09:00:00+09:00', 2
  }
}

Table trading.position_lot_reservations {
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  reservation_id uuid [not null]
  position_lot_id uuid [not null]
  reserved_quantity numeric(28,8) [not null]

  indexes {
    (reservation_id, position_lot_id) [pk]
    (position_lot_id)
  }

  checks {
    `reserved_quantity > 0` [name: 'position_lot_reservation_quantity_positive']
  }

  Note: 'POSITION_QUANTITY 예약이 같은 Bot·Partition·Flow의 FIFO lot 중 어떤 잔량을 잠갔는지 고정한다. 복합 FK가 다른 파티션 또는 다른 Flow의 lot 매도를 차단하고, 활성 예약 합계는 지연 트리거가 현재 잔량 이하로 제한한다.'
}

Table trading.order_component_reservations {
  bot_id uuid [not null]
  partition_id uuid [not null]
  reservation_id uuid [pk, not null]
  order_component_id uuid [not null]
  reserved_amount numeric(24,8)
  reserved_quantity numeric(28,8)

  indexes {
    (order_component_id)
  }

  checks {
    `(reserved_amount IS NOT NULL) <> (reserved_quantity IS NOT NULL)` [name: 'order_component_reservation_exactly_one_measure']
    `reserved_amount IS NULL OR reserved_amount > 0` [name: 'order_component_reservation_amount_positive']
    `reserved_quantity IS NULL OR reserved_quantity > 0` [name: 'order_component_reservation_quantity_positive']
  }

  Note: '최종 Order의 각 구성 내역을 실제 현금·Position 수량 예약과 연결한다. 하나의 resource reservation은 하나의 order component만 뒷받침하지만 같은 Order의 여러 개별 부분 체결에 걸쳐 순차적으로 소비될 수 있다. replacement Order는 새 예약을 만든다.'

  Records (bot_id, partition_id, reservation_id, order_component_id, reserved_amount) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 312.92240353
  }
}

Table trading.reservation_events {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  reservation_id uuid [not null]
  bot_event_id uuid [not null]
  source_fill_id uuid
  event_key varchar(160) [not null]
  reservation_sequence bigint [not null]
  event_type trading.reservation_event_type [not null]
  consumed_amount_delta numeric(24,8)
  released_amount_delta numeric(24,8)
  consumed_quantity_delta numeric(28,8)
  released_quantity_delta numeric(28,8)
  status_after trading.reservation_status [not null]
  occurred_at timestamptz [not null]
  event_hash varchar(128) [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (reservation_id, reservation_sequence) [unique]
    (reservation_id, event_key) [unique]
    (source_fill_id, reservation_id)
  }

  checks {
    `reservation_sequence > 0` [name: 'reservation_event_sequence_positive']
    `consumed_amount_delta IS NULL OR consumed_amount_delta >= 0` [name: 'reservation_event_consumed_amount_nonnegative']
    `released_amount_delta IS NULL OR released_amount_delta >= 0` [name: 'reservation_event_released_amount_nonnegative']
    `consumed_quantity_delta IS NULL OR consumed_quantity_delta >= 0` [name: 'reservation_event_consumed_quantity_nonnegative']
    `released_quantity_delta IS NULL OR released_quantity_delta >= 0` [name: 'reservation_event_released_quantity_nonnegative']
    `event_type NOT IN ('CONSUMED_BY_FILL', 'SETTLED_BY_FILL') OR source_fill_id IS NOT NULL` [name: 'fill_consumption_source_required']
    `event_type IN ('CONSUMED_BY_FILL', 'SETTLED_BY_FILL') OR source_fill_id IS NULL` [name: 'non_fill_reservation_event_has_no_fill']
    `event_type <> 'CONSUMED_BY_FILL' OR status_after = 'ACTIVE'` [name: 'partial_fill_consumption_stays_active']
    `event_type <> 'SETTLED_BY_FILL' OR status_after = 'SETTLED'` [name: 'fill_settlement_status_valid']
    `event_type NOT IN ('RELEASED_BY_CANCEL', 'RELEASED_BY_EXPIRY', 'RELEASED_BY_REJECTION', 'RELEASED_BY_REPLACEMENT') OR status_after IN ('RELEASED', 'SETTLED')` [name: 'release_event_status_valid']
  }

  Note: '예약 생성, 각 개별 Fill의 부분 소비와 최종 정산을 추가 전용으로 기록한다. CONSUMED_BY_FILL은 예약을 ACTIVE로 유지하며 실제 사용량만 누적하고, SETTLED_BY_FILL은 마지막 체결의 소비와 완충액·잔액 해제를 함께 기록한다. 취소·만료·거절·replacement는 미사용 잔액을 해제하며, 앞서 소비된 양이 있으면 SETTLED, 없으면 RELEASED로 끝난다. event_key와 sequence가 중복 효과를 차단한다.'

  Records (id, bot_id, partition_id, reservation_id, bot_event_id, source_fill_id, event_key, reservation_sequence, event_type, consumed_amount_delta, released_amount_delta, status_after, occurred_at, event_hash) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', null, 'P1:CASH:CREATED:1', 1, 'CREATED', null, null, 'ACTIVE', '2026-07-28T09:00:00+09:00', 'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
    '00000000-0000-4000-8000-000000000002', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'P1:CASH:SETTLE:FILL1', 2, 'SETTLED_BY_FILL', 312.89111442, 0.03128911, 'SETTLED', '2026-07-28T09:01:00+09:00', 'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee'
  }
}

Table trading.order_events {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  order_id uuid [not null]
  bot_event_id uuid [not null, unique]
  order_sequence bigint [not null]
  event_type varchar(50) [not null]
  previous_status trading.order_status
  new_status trading.order_status [not null]
  reason_code varchar(80)
  occurred_at timestamptz [not null]
  event_document jsonb [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (order_id, order_sequence) [unique]
    (bot_id, partition_id, bot_event_id) [unique]
  }

  checks {
    `order_sequence > 0` [name: 'order_event_sequence_positive']
  }

  Note: '주문 상태 전이의 추가 전용 정본. 정상 경로는 PENDING/OPEN에서 하나 이상의 부분 체결을 누적한 뒤 FILLED, CANCELLED 또는 EXPIRED로 끝날 수 있고, 체결이 전혀 없는 주문은 REJECTED로 끝날 수 있다. 별도 PARTIALLY_FILLED 상태를 만들지 않고 OPEN 상태와 누적 filled_quantity로 부분 체결을 표현한다. CANCELLED는 사용자·봇 중지·운영자 강제 취소가 아니라 자동 replacement에서 원본 주문을 철회할 때만 허용하며 replacement 전 원본은 CANCELLED 사건을 먼저 가져야 한다.'

  Records (id, bot_id, partition_id, order_id, bot_event_id, order_sequence, event_type, previous_status, new_status, reason_code, occurred_at, event_document) {
    '00000000-0000-4000-8000-000000000002', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 2, 'ORDER_FILLED', 'OPEN', 'FILLED', 'FULL_FILL', '2026-07-28T09:01:00+09:00', '{"requestedQuantity":"3.12110526","fillQuantity":"3.12110526","cumulativeFilledQuantity":"3.12110526","remainingQuantity":"0"}'
  }
}

Table trading.order_state_projections {
  order_id uuid [pk]
  bot_id uuid [not null]
  partition_id uuid [not null]
  status trading.order_status [not null]
  filled_quantity numeric(28,8) [not null]
  remaining_quantity numeric(28,8) [not null]
  reserved_cash numeric(24,8) [not null]
  reserved_quantity numeric(28,8) [not null]
  active_stop_price numeric(24,8)
  trailing_reference_price numeric(24,8)
  last_order_event_sequence bigint [not null]
  last_bot_event_sequence bigint [not null]
  updated_at timestamptz [not null]

  indexes {
    (bot_id, partition_id, order_id) [unique]
    (bot_id, partition_id, status, updated_at)
  }

  checks {
    `filled_quantity >= 0` [name: 'order_projection_filled_nonnegative']
    `remaining_quantity >= 0` [name: 'order_projection_remaining_nonnegative']
    `reserved_cash >= 0` [name: 'order_projection_reserved_cash_nonnegative']
    `reserved_quantity >= 0` [name: 'order_projection_reserved_quantity_nonnegative']
    `active_stop_price IS NULL OR active_stop_price > 0` [name: 'order_projection_active_stop_positive']
    `trailing_reference_price IS NULL OR trailing_reference_price > 0` [name: 'order_projection_trailing_reference_positive']
    `status <> 'FILLED' OR (filled_quantity > 0 AND remaining_quantity = 0)` [name: 'filled_projection_is_complete']
    `status <> 'REJECTED' OR (filled_quantity = 0 AND remaining_quantity = 0)` [name: 'rejected_projection_has_no_fill']
    `status NOT IN ('CANCELLED', 'EXPIRED') OR remaining_quantity = 0` [name: 'closed_projection_has_no_active_remainder']
    `status <> 'PENDING' OR (filled_quantity = 0 AND remaining_quantity > 0)` [name: 'pending_projection_has_no_fill']
    `status <> 'OPEN' OR remaining_quantity > 0` [name: 'open_projection_has_remaining_quantity']
  }

  Note: '재구축 가능한 현재 주문 읽기 모델. filled_quantity는 정상 Fill과 유효한 반전의 누적 체결 수량이며 0부터 Order 요청 수량까지의 중간값을 허용한다. OPEN 주문은 부분 체결 뒤에도 양수 remaining_quantity를 유지할 수 있고, FILLED는 누적 체결이 요청 수량에 도달해 remaining_quantity가 0인 경우다. CANCELLED·EXPIRED는 누적 체결량을 보존하되 더 이상 활성 잔량이 없으므로 remaining_quantity가 0이다. 정본은 order_events, fills와 fill_adjustments다.'

  Records (order_id, bot_id, partition_id, status, filled_quantity, remaining_quantity, reserved_cash, reserved_quantity, last_order_event_sequence, last_bot_event_sequence, updated_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'FILLED', 3.12110526, 0.00000000, 0.00000000, 0.00000000, 2, 2, '2026-07-28T09:01:00+09:00'
  }
}

Table trading.fills {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  bot_id uuid [not null]
  partition_id uuid [not null]
  bot_event_id uuid [not null, unique]
  provider_fill_key varchar(160) [not null]
  quantity numeric(28,8) [not null]
  reference_price numeric(24,8) [not null]
  reference_observed_at timestamptz [not null]
  reference_market_hash varchar(128) [not null]
  slippage_rate_bps int [not null]
  slippage_amount numeric(24,8) [not null]
  fill_price numeric(24,8) [not null]
  gross_amount numeric(24,8) [not null]
  fee_policy_id uuid [not null]
  fee_rate_bps int [not null]
  precision_rules_version varchar(80) [not null]
  fee_basis_amount numeric(24,8) [not null]
  fee_amount numeric(24,8) [not null]
  settlement_cash_delta numeric(24,8) [not null, note: '매수는 음수, 매도는 양수인 공식 현금 변동.']
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, order_id, id) [unique]
    (order_id, occurred_at, id)
    (bot_id, partition_id, provider_fill_key) [unique]
    (bot_id, partition_id, occurred_at)
    (partition_id, occurred_at)
  }

  checks {
    `quantity > 0` [name: 'fill_quantity_positive']
    `reference_price > 0` [name: 'fill_reference_price_positive']
    `slippage_rate_bps = 5` [name: 'fill_fixed_slippage_five_bps']
    `slippage_amount >= 0` [name: 'fill_slippage_amount_nonnegative']
    `fill_price > 0` [name: 'fill_price_positive']
    `gross_amount > 0` [name: 'fill_gross_amount_positive']
    `fee_rate_bps = 20` [name: 'fill_fee_twenty_bps']
    `fee_basis_amount > 0` [name: 'fill_fee_basis_positive']
    `fee_amount >= 0` [name: 'fill_fee_nonnegative']
  }

  Note: 'Order에 발생한 각 정상 개별 체결을 추가 전용으로 기록한다. 하나의 Order는 여러 fills를 가질 수 있고 각 quantity는 양수이며, 유효 Fill 수량의 누계가 Order.requested_quantity를 초과하지 않도록 PostgreSQL 지연 제약 트리거가 검증한다. provider_fill_key는 같은 Bot·Partition에서 동일 체결 전달을 멱등하게 식별한다. 각 체결은 당시 최신 유효 참조가격에 고정 5 bps 슬리피지와 공식 20 bps 수수료를 적용하며 Buying Power 버퍼는 기록하거나 체결가·손익에 반영하지 않는다.'

  Records (id, order_id, bot_id, partition_id, bot_event_id, provider_fill_key, quantity, reference_price, reference_observed_at, reference_market_hash, slippage_rate_bps, slippage_amount, fill_price, gross_amount, fee_policy_id, fee_rate_bps, precision_rules_version, fee_basis_amount, fee_amount, settlement_cash_delta, occurred_at, recorded_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 'SIM:FILL:P1:ORDER1', 3.12110526, 100.00000000, '2026-07-28T09:01:00+09:00', 'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff', 5, 0.15605526, 100.05000000, 312.26658126, '00000000-0000-4000-8000-000000000001', 20, '1.0.0', 312.26658126, 0.62453316, -312.89111442, '2026-07-28T09:01:00+09:00', '2026-07-28T09:01:00+09:00'
  }
}

Table trading.fill_component_allocations {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  order_id uuid [not null]
  fill_id uuid [not null]
  order_component_id uuid [not null]
  allocation_sequence int [not null]
  allocated_quantity numeric(28,8) [not null]
  allocated_gross_amount numeric(24,8) [not null]
  allocated_fee_amount numeric(24,8) [not null]
  allocated_settlement_cash_delta numeric(24,8) [not null]
  allocation_rules_version varchar(40) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, order_id, fill_id, id) [unique]
    (bot_id, partition_id, order_id, order_component_id, id) [unique]
    (bot_id, partition_id, order_component_id, id) [unique]
    (fill_id, order_component_id) [unique]
    (fill_id, allocation_sequence) [unique]
    (order_component_id, fill_id)
  }

  checks {
    `allocation_sequence > 0` [name: 'fill_allocation_sequence_positive']
    `allocated_quantity > 0` [name: 'fill_allocation_quantity_positive']
    `allocated_gross_amount > 0` [name: 'fill_allocation_gross_positive']
    `allocated_fee_amount >= 0` [name: 'fill_allocation_fee_nonnegative']
    `allocated_settlement_cash_delta <> 0` [name: 'fill_allocation_cash_delta_nonzero']
  }

  Note: '하나의 개별 Fill 수량과 경제 효과를 해당 Order를 구성한 Flow별 order component에 결정적으로 귀속하는 추가 전용 정본. 같은 Fill·component 쌍은 한 번만 나타나고 allocation_sequence가 Fill 내부 순서를 고정한다. Fill별 allocated_quantity·allocated_gross_amount·allocated_fee_amount·allocated_settlement_cash_delta 합계는 각각 Fill의 quantity·gross_amount·fee_amount·settlement_cash_delta와 정확히 같아야 하며, component별 누적 배분 수량은 component_quantity를 초과할 수 없다. allocation_rules_version은 투자 판단이 아닌 결정론적 회계 귀속 규칙 버전을 고정한다. 복합 FK와 PostgreSQL 지연 제약 트리거가 Bot·Partition·Order 소유 및 합계 정합성을 강제한다.'

  Records (id, bot_id, partition_id, order_id, fill_id, order_component_id, allocation_sequence, allocated_quantity, allocated_gross_amount, allocated_fee_amount, allocated_settlement_cash_delta, allocation_rules_version, created_at) {
    '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', 1, 3.12110526, 312.26658126, 0.62453316, -312.89111442, '1.0.0', '2026-07-28T09:01:00+09:00'
  }
}

Table trading.fill_adjustments {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  fill_id uuid [not null]
  bot_event_id uuid [not null]
  adjustment_key varchar(160) [not null]
  adjustment_type trading.fill_adjustment_type [not null]
  quantity_delta numeric(28,8) [not null, default: 0]
  gross_amount_delta numeric(24,8) [not null, default: 0]
  fee_amount_delta numeric(24,8) [not null, default: 0]
  settlement_cash_delta numeric(24,8) [not null, default: 0]
  reason_code varchar(80) [not null]
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    (bot_id, partition_id, id) [unique]
    (fill_id, adjustment_key) [unique]
    (bot_id, partition_id, bot_event_id) [unique]
  }

  checks {
    `quantity_delta <> 0 OR gross_amount_delta <> 0 OR fee_amount_delta <> 0 OR settlement_cash_delta <> 0` [name: 'fill_adjustment_has_effect']
    `adjustment_type <> 'CORRECTION' OR quantity_delta = 0` [name: 'fill_correction_does_not_change_quantity']
  }

  Note: '정상 Fill을 복제하지 않고 사후 정정·반전을 명시적으로 남기는 추가 전용 사건. CORRECTION은 quantity_delta = 0을 유지하면서 가격·금액·수수료만 조정한다. 체결 수량을 바꿔야 하면 기존 Fill의 경제 효과와 수량을 정확히 반전하는 REVERSAL을 기록한 뒤 수정된 수량의 새 Fill과 새 배분을 추가한다. migration trigger가 반전 정합성과 Order별 유효 누적 체결 수량을 검증한다.'
}

Table trading.ledger_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  account_key varchar(240) [not null, note: '봇 안에서 범위·계정유형·통화·종목을 정규화한 null 없는 안정 키.']
  partition_id uuid
  flow_id uuid
  account_type varchar(50) [not null]
  currency_code char(3)
  instrument_id uuid
  created_at timestamptz [not null]
  closed_at timestamptz

  indexes {
    (bot_id, id) [unique]
    (bot_id, partition_id, id) [unique]
    (bot_id, account_key) [unique]
    (bot_id, partition_id, flow_id, account_type)
  }

  checks {
    `flow_id IS NULL OR partition_id IS NOT NULL` [name: 'ledger_flow_requires_partition']
    `(currency_code IS NOT NULL) <> (instrument_id IS NOT NULL)` [name: 'ledger_account_exactly_one_unit']
    `closed_at IS NULL OR closed_at > created_at` [name: 'ledger_account_close_after_create']
  }

  Note: '복식 원장의 계정 차원. 거래용 계정은 반드시 Partition에 속하고 Flow 귀속 자산 계정은 flow_id도 가진다. OPEN_SHORT Fill 매도대금은 일반 CASH가 아니라 SEGREGATED_SHORT_PROCEEDS 계정에 기록하며 CLOSE_SHORT 정산 전까지 새 주문의 Buying Power로 사용할 수 없다. Bot 전체 초기자본·미배정 현금 계정만 partition_id가 없을 수 있다. account_key와 제약 트리거가 scope 컬럼 일치를 검증한다.'
}

Table trading.ledger_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid
  bot_event_id uuid [not null, unique]
  transaction_type varchar(60) [not null]
  transaction_key varchar(160) [not null]
  source_type varchar(40) [not null]
  source_id uuid [not null]
  currency_code char(3) [not null]
  reversal_of_transaction_id uuid
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null, default: `now()`]
  description_code varchar(80) [not null]

  indexes {
    (bot_id, id) [unique]
    (bot_id, partition_id, id) [unique]
    (bot_id, transaction_key) [unique]
    (bot_id, source_type, source_id) [unique]
    (bot_id, occurred_at)
  }

  Note: '추가 전용 회계 사건 헤더. FILL·FILL_ADJUSTMENT·차입비용·기업행사·초기자본을 멱등 source로 식별한다. FILL과 그 조정은 partition_id가 필수이며 같은 파티션 Ledger Account만 사용할 수 있다. 초기자본처럼 Bot 전체 사건만 partition_id가 없다.'
}

Table trading.ledger_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid
  transaction_id uuid [not null]
  ledger_account_id uuid [not null]
  order_component_id uuid
  entry_sequence int [not null]
  direction trading.ledger_direction [not null]
  amount numeric(24,8) [not null]
  quantity numeric(28,8)
  entry_hash varchar(128) [not null]

  indexes {
    (transaction_id, entry_sequence) [unique]
    (bot_id, partition_id, ledger_account_id, transaction_id)
    (order_component_id, transaction_id)
  }

  checks {
    `entry_sequence > 0` [name: 'ledger_entry_sequence_positive']
    `amount > 0` [name: 'ledger_entry_amount_positive']
    `quantity IS NULL OR quantity <> 0` [name: 'ledger_entry_quantity_nonzero']
    `order_component_id IS NULL OR partition_id IS NOT NULL` [name: 'order_component_ledger_entry_requires_partition']
  }

  Note: '추가 전용 차변·대변 분개. Fill 거래의 Flow별 귀속은 order_component_id로 직접 이어지고 Flow 자체는 component의 Intent에서 유도한다. 지연 트리거가 Fill 없는 체결 분개, 파티션 불일치, 구성별 금액·수수료 합계 불일치와 불균형 분개를 커밋 시 차단한다.'
}

Table trading.position_lots {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  instrument_id uuid [not null]
  opening_order_component_id uuid [not null]
  opening_fill_allocation_id uuid [not null, unique]
  lot_side trading.lot_side [not null]
  opened_quantity numeric(28,8) [not null]
  unit_cost numeric(24,8) [not null]
  opened_cost_basis_amount numeric(24,8) [not null]
  opened_at timestamptz [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (bot_id, partition_id, flow_id, id) [unique]
    (bot_id, partition_id, opening_order_component_id, opening_fill_allocation_id) [unique]
    (opening_order_component_id, opened_at, id)
    (partition_id, flow_id, instrument_id, opened_at)
    (bot_id, partition_id, instrument_id, opened_at)
  }

  checks {
    `opened_quantity > 0` [name: 'position_lot_opened_quantity_positive']
    `unit_cost >= 0` [name: 'position_lot_unit_cost_nonnegative']
    `opened_cost_basis_amount >= 0` [name: 'position_lot_opened_basis_nonnegative']
  }

  Note: '각 부분 또는 전량 Fill의 component 배분마다 생성되는 불변 Flow별 FIFO 원가 묶음. 같은 order component가 여러 개별 체결에 배분되면 여러 lot을 가질 수 있으며 opening_fill_allocation_id가 정확한 Fill·component 배분을 고정한다. 복합 FK와 지연 트리거가 동일 Bot·Partition·Order·Flow·instrument 및 OPEN position_effect를 강제한다.'
}

Table trading.lot_movements {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  position_lot_id uuid [not null]
  bot_event_id uuid [not null]
  source_fill_allocation_id uuid
  source_fill_adjustment_id uuid
  corporate_action_id uuid
  reverses_movement_id uuid
  movement_type trading.lot_movement_type [not null]
  quantity_delta numeric(28,8) [not null]
  cost_basis_delta numeric(24,8) [not null]
  remaining_after numeric(28,8) [not null]
  cost_basis_after numeric(24,8) [not null]
  occurred_at timestamptz [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (position_lot_id, id) [unique]
    (position_lot_id, bot_event_id) [unique]
    (source_fill_allocation_id, position_lot_id)
    (source_fill_adjustment_id, position_lot_id)
  }

  checks {
    `quantity_delta <> 0` [name: 'lot_movement_quantity_nonzero']
    `remaining_after >= 0` [name: 'lot_movement_remaining_nonnegative']
    `cost_basis_after >= 0` [name: 'lot_movement_basis_nonnegative']
    `(CASE WHEN source_fill_allocation_id IS NOT NULL THEN 1 ELSE 0 END + CASE WHEN source_fill_adjustment_id IS NOT NULL THEN 1 ELSE 0 END + CASE WHEN corporate_action_id IS NOT NULL THEN 1 ELSE 0 END) <= 1` [name: 'lot_movement_source_not_ambiguous']
    `movement_type NOT IN ('OPEN', 'CLOSE') OR source_fill_allocation_id IS NOT NULL` [name: 'fill_movement_source_required']
    `movement_type <> 'CORPORATE_ACTION_ADJUSTMENT' OR corporate_action_id IS NOT NULL` [name: 'corporate_movement_source_required']
    `movement_type <> 'REVERSAL' OR (reverses_movement_id IS NOT NULL AND source_fill_adjustment_id IS NOT NULL)` [name: 'reversal_movement_source_required']
  }

  Note: '개별 로트의 OPEN·FIFO CLOSE·기업행사·정정·반전을 추가 전용으로 보존한다. 정상 거래 이동은 정확한 fill_component_allocation을 가리켜 개별 Fill과 Flow별 order component를 함께 증명한다. 다른 Bot·Partition·Flow lot 소비와 Fill 없는 이동은 복합 FK와 지연 트리거가 차단한다.'
}

Table trading.position_lot_projections {
  position_lot_id uuid [pk]
  remaining_quantity numeric(28,8) [not null]
  remaining_cost_basis_amount numeric(24,8) [not null]
  active_reserved_quantity numeric(28,8) [not null]
  last_movement_id uuid [not null]
  last_event_sequence bigint [not null]
  closed_at timestamptz
  updated_at timestamptz [not null]

  checks {
    `remaining_quantity >= 0` [name: 'lot_projection_remaining_nonnegative']
    `remaining_cost_basis_amount >= 0` [name: 'lot_projection_basis_nonnegative']
    `active_reserved_quantity >= 0 AND active_reserved_quantity <= remaining_quantity` [name: 'lot_projection_reservation_within_remaining']
    `(remaining_quantity = 0) = (closed_at IS NOT NULL)` [name: 'lot_projection_closed_consistent']
  }

  Note: '재구축 가능한 로트 현재 상태. 동일 Flow의 FIFO 예약과 청산 조회를 빠르게 하며 정본은 position_lots와 lot_movements다.'
}

Table trading.short_trade_checks {
  intent_id uuid [pk]
  short_risk_policy_id uuid [not null]
  assessed_at timestamptz [not null]
  reference_price numeric(24,8) [not null]
  projected_short_quantity numeric(28,8) [not null]
  projected_exposure_amount numeric(24,8) [not null]
  required_initial_collateral_amount numeric(24,8) [not null]
  required_maintenance_collateral_amount numeric(24,8) [not null]
  rule_201_triggered boolean [not null]
  rule_201_triggered_at timestamptz
  prior_regular_close_price numeric(24,8) [not null]
  national_best_bid_price numeric(24,8) [not null]
  minimum_permitted_short_price numeric(24,8)
  price_rule_observed_at timestamptz [not null]
  price_rule_market_hash varchar(128) [not null]
  liquidation_reference_price numeric(24,8)
  approved boolean [not null]
  decision_reason_code varchar(80) [not null]
  evidence_hash varchar(128) [not null]

  checks {
    `reference_price > 0` [name: 'short_check_reference_price_positive']
    `projected_short_quantity > 0` [name: 'short_check_quantity_positive']
    `projected_exposure_amount > 0` [name: 'short_check_exposure_positive']
    `required_initial_collateral_amount >= 0` [name: 'short_check_initial_collateral_nonnegative']
    `required_maintenance_collateral_amount >= 0` [name: 'short_check_maintenance_collateral_nonnegative']
    `required_initial_collateral_amount >= required_maintenance_collateral_amount` [name: 'short_check_initial_not_below_maintenance']
    `prior_regular_close_price > 0` [name: 'short_check_prior_close_positive']
    `national_best_bid_price > 0` [name: 'short_check_nbb_positive']
    `NOT rule_201_triggered OR (rule_201_triggered_at IS NOT NULL AND minimum_permitted_short_price > national_best_bid_price)` [name: 'short_check_rule_201_evidence_required']
    `rule_201_triggered OR (rule_201_triggered_at IS NULL AND minimum_permitted_short_price IS NULL)` [name: 'short_check_no_rule_201_evidence_when_inactive']
    `liquidation_reference_price IS NULL OR liquidation_reference_price > 0` [name: 'short_check_liquidation_price_positive']
  }

  Note: 'OPEN_SHORT 의도 승인에 사용한 가상 Short 노출, 최초·유지 담보, Rule 201 가격 제한과 청산 기준의 불변 판단 증적. 전일 정규장 종가 대비 장중 10% 이상 하락해 Rule 201이 발동하면 유효한 national best bid보다 높은 가격에서만 가상 공매도 Fill을 허용하며, 고정 매도 슬리피지를 적용한 Fill 가격도 이 조건을 만족해야 한다. 실제 주식 차입, 대여 가능 수량과 대여기관 회수는 판단하거나 저장하지 않는다.'
}

Table trading.system_close_actions {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  flow_id uuid [not null]
  instrument_id uuid [not null]
  source_event_id uuid [not null]
  reason_type trading.system_close_reason [not null]
  requested_quantity numeric(28,8) [not null]
  generated_intent_id uuid [not null, unique]
  reason_document jsonb [not null]
  calculation_hash varchar(128) [not null]
  created_at timestamptz [not null]

  indexes {
    (bot_id, source_event_id, instrument_id, reason_type) [unique]
    (flow_id, created_at)
  }

  checks {
    `requested_quantity > 0` [name: 'system_close_quantity_positive']
  }

  Note: '가상 Position의 위험 한도 위반, Bot 중단, 대회 종료 또는 데이터 무결성 차단에 따라 플랫폼이 생성한 강제 청산 근거. 실제 대여기관 회수 사건은 만들지 않는다. 데이터 무결성 차단은 청산 필요성을 기록하되 유효한 최신 가격 전에는 Fill을 만들지 않는다. 사용자 Flow 판단과 구분하며 생성된 SYSTEM_* 주문 의도부터 파티션 전용 Order·개별 부분 체결·원장까지 동일 경로로 추적한다.'
}

Table trading.short_borrow_fee_accruals {
  id uuid [pk, default: `gen_random_uuid()`]
  bot_id uuid [not null]
  partition_id uuid [not null]
  position_lot_id uuid [not null]
  bot_event_id uuid [not null, unique]
  short_borrow_fee_policy_id uuid [not null]
  ledger_transaction_id uuid [not null, unique]
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  annual_fee_rate_bps numeric(12,6) [not null]
  day_count_basis varchar(20) [not null]
  fee_basis_amount numeric(24,8) [not null]
  accrued_fee_amount numeric(24,8) [not null]
  calculation_hash varchar(128) [not null]

  indexes {
    (bot_id, partition_id, id) [unique]
    (position_lot_id, period_start, period_end) [unique]
  }

  checks {
    `period_end > period_start` [name: 'short_borrow_fee_period_valid']
    `annual_fee_rate_bps >= 0` [name: 'short_borrow_fee_rate_nonnegative']
    `fee_basis_amount >= 0` [name: 'short_borrow_fee_basis_nonnegative']
    `accrued_fee_amount >= 0` [name: 'short_borrow_fee_amount_nonnegative']
  }

  Note: '열린 가상 SHORT lot에 플랫폼 고정 연간 대차료를 기간별로 추가 전용 계산하고 공식 원장과 1:1 연결한다. 실제 대차시장 금리가 아니며 policy id, 적용 bps, day-count와 계산 해시를 고정한다. PostgreSQL 마이그레이션은 같은 lot의 비용 기간이 겹치지 않도록 exclusion constraint를 둔다.'
}

Table trading.flow_position_projections {
  flow_id uuid [not null]
  partition_id uuid [not null]
  bot_id uuid [not null]
  instrument_id uuid [not null]
  long_quantity numeric(28,8) [not null]
  short_quantity numeric(28,8) [not null]
  cost_basis_amount numeric(24,8) [not null]
  last_event_sequence bigint [not null]
  projection_hash varchar(128) [not null]
  updated_at timestamptz [not null]

  indexes {
    (flow_id, instrument_id) [pk]
    (bot_id, instrument_id)
    (partition_id, instrument_id)
  }

  checks {
    `long_quantity >= 0` [name: 'flow_position_long_nonnegative']
    `short_quantity >= 0` [name: 'flow_position_short_nonnegative']
    `cost_basis_amount >= 0` [name: 'flow_position_basis_nonnegative']
  }

  Note: '재구축 가능한 PostgreSQL 현재 Projection. 공식 이력은 체결, 로트 변동, 원장 분개.'
}

Table trading.partition_position_projections {
  partition_id uuid [not null]
  bot_id uuid [not null]
  instrument_id uuid [not null]
  net_quantity numeric(28,8) [not null]
  average_cost numeric(24,8)
  realized_pnl numeric(24,8) [not null]
  last_valuation_price numeric(24,8)
  last_valuation_at timestamptz
  valuation_status varchar(30) [not null]
  last_bot_event_sequence bigint [not null]
  updated_at timestamptz [not null]

  indexes {
    (partition_id, instrument_id) [pk]
    (bot_id, partition_id, instrument_id) [unique]
    (bot_id, instrument_id)
  }

  checks {
    `average_cost IS NULL OR average_cost >= 0` [name: 'position_projection_average_cost_nonnegative']
    `last_valuation_price IS NULL OR last_valuation_price > 0` [name: 'position_projection_valuation_price_positive']
  }

  Note: '주문 가능 보유량과 순포지션 검사에 사용하는 재구축 가능한 파티션별 현재 상태. 서로 다른 파티션 포지션을 상계하지 않으며 Bot 전체 화면은 이 행들을 읽기 전용으로 합산한다. 원장·로트 기록이 정본.'

}

Table trading.bot_budget_projections {
  bot_id uuid [pk]
  currency_code char(3) [not null]
  available_cash_amount numeric(24,8) [not null]
  active_reservation_amount numeric(24,8) [not null]
  invested_amount numeric(24,8) [not null]
  segregated_short_proceeds_amount numeric(24,8) [not null]
  short_collateral_amount numeric(24,8) [not null]
  valuation_at timestamptz [not null]
  valuation_status varchar(30) [not null]
  last_event_sequence bigint [not null]
  projection_hash varchar(128) [not null]
  updated_at timestamptz [not null]

  checks {
    `available_cash_amount >= 0` [name: 'bot_budget_available_nonnegative']
    `active_reservation_amount >= 0` [name: 'bot_budget_reservation_nonnegative']
    `invested_amount >= 0` [name: 'bot_budget_invested_nonnegative']
    `segregated_short_proceeds_amount >= 0` [name: 'bot_budget_short_proceeds_nonnegative']
    `short_collateral_amount >= 0` [name: 'bot_budget_short_collateral_nonnegative']
  }

  Note: '공식 원장·활성 resource_reservations·현재 청산가능 호가 평가에서 재구축하는 봇 예산 Projection. 가용현금은 격리 숏 매도대금과 담보를 제외하며 정본으로 사용하지 않는다.'
}

Table trading.partition_budget_projections {
  partition_id uuid [pk]
  bot_id uuid [not null]
  currency_code char(3) [not null]
  budget_cap_amount numeric(24,8) [not null]
  active_reservation_amount numeric(24,8) [not null]
  invested_amount numeric(24,8) [not null]
  segregated_short_proceeds_amount numeric(24,8) [not null]
  short_collateral_amount numeric(24,8) [not null]
  valuation_at timestamptz [not null]
  valuation_status varchar(30) [not null]
  last_event_sequence bigint [not null]
  projection_hash varchar(128) [not null]
  updated_at timestamptz [not null]

  indexes {
    (bot_id, partition_id) [unique]
  }

  checks {
    `budget_cap_amount > 0` [name: 'partition_budget_cap_positive']
    `active_reservation_amount >= 0` [name: 'partition_budget_reservation_nonnegative']
    `invested_amount >= 0` [name: 'partition_budget_invested_nonnegative']
    `segregated_short_proceeds_amount >= 0` [name: 'partition_budget_short_proceeds_nonnegative']
    `short_collateral_amount >= 0` [name: 'partition_budget_short_collateral_nonnegative']
  }

  Note: '파티션 상한 사용량의 재구축 가능한 Projection. bot_id를 명시해 테넌트·소유 범위를 보존하고, 현재 청산가능 가격의 보유액·활성 예약·격리 숏 대금·담보를 공식 계산 규칙대로 분리한다.'
}

// -----------------------------------------------------------------------------
// backtest: repeatable whole-bot runs, independent from live runtime.
// -----------------------------------------------------------------------------

Table backtest.runs {
  id uuid [pk, default: `gen_random_uuid()`]
