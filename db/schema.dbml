  granted_at timestamptz [not null, default: `now()`]

  indexes {
    (authorization_id, scope_code) [pk]
  }

  Note: 'Immutable after authorization activation. Release, bot lifecycle, room final actions, continuation renewal, and order mutation scopes intentionally do not exist; changing permissions requires a new explicit user grant.'

