Table operations.outbox_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_domain varchar(40) [not null]
  aggregate_id uuid [not null]
  aggregate_sequence bigint
  event_type varchar(100) [not null]
  event_schema_version varchar(40) [not null]
  payload_document jsonb [not null]
  idempotency_key varchar(160) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  publish_attempt_count int [not null, default: 0]
  next_attempt_at timestamptz
  last_failure_code varchar(80)

  indexes {
    (published_at, next_attempt_at)
    (owner_domain, aggregate_id, aggregate_sequence)
  }

  Note: '도메인 변경과 원자적으로 삽입. 퍼블리셔는 at-least-once 전달일 수 있으므로 모든 컨슈머가 idempotency_key를 사용.'

  Records (id, owner_domain, aggregate_id, aggregate_sequence, event_type, event_schema_version, payload_document, idempotency_key, created_at, published_at, publish_attempt_count, next_attempt_at, last_failure_code) {
    '00000000-0000-4000-8000-000000000001', 'review-example', '00000000-0000-4000-8000-000000000001', 1, 'REVIEW_EXAMPLE', '1.0.0', '{"eventType":"BOT_EXECUTION_BLOCKED","botId":"00000000-0000-4000-8000-000000000001","reasonCode":"LEDGER_INVARIANT_VIOLATED"}', 'REVIEW_EXAMPLE', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00', 1, '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE'
  }
}

Table operations.projection_checkpoints {
  id uuid [pk, default: `gen_random_uuid()`]
  projection_name varchar(100) [not null]
  target_store varchar(40) [not null, note: '값은 NOSQL, SEARCH, CACHE, POSTGRES_READ_MODEL.']
  shard_key varchar(160) [not null]
  source_domain varchar(40) [not null]
  last_source_sequence bigint
  last_source_time timestamptz
  projection_version varchar(40) [not null]
  status varchar(30) [not null]
  updated_at timestamptz [not null]
  failure_code varchar(80)

  indexes {
    (projection_name, target_store, shard_key) [unique]
    (status, updated_at)
  }

  Note: '일회성인 NoSQL·검색·캐시 콘텐츠는 PostgreSQL과 검증된 S3 오브젝트로부터 재구축 가능해야 한다.'

  Records (id, projection_name, target_store, shard_key, source_domain, last_source_sequence, last_source_time, projection_version, status, updated_at, failure_code) {
    '00000000-0000-4000-8000-000000000001', 'Review Example', 'review-example', 'REVIEW_EXAMPLE', 'review-example', 1, '2026-07-27T09:00:00+09:00', '1.0.0', 'ACTIVE', '2026-07-27T09:00:00+09:00', 'REVIEW_EXAMPLE'
  }
}

Table operations.audit_events {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_type varchar(30) [not null]
  actor_id uuid [not null]
  delegated_authorization_id uuid
  action_type varchar(100) [not null]
  target_domain varchar(40) [not null]
  target_id uuid [not null]
  reason_code varchar(80) [not null]
  correlation_id uuid [not null]
  idempotency_key varchar(160) [not null, unique]
  before_hash varchar(128)
  after_hash varchar(128)
  evidence_object_id uuid
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null, default: `now()`]

  indexes {
    (target_domain, target_id, occurred_at)
    (actor_type, actor_id, occurred_at)
    (delegated_authorization_id, occurred_at)
    (correlation_id)
  }

  checks {
    `(actor_type = 'DELEGATED_AUTHORIZATION' AND delegated_authorization_id IS NOT NULL AND actor_id = delegated_authorization_id) OR (actor_type <> 'DELEGATED_AUTHORIZATION' AND delegated_authorization_id IS NULL)` [name: 'audit_delegated_actor_reference_valid']
  }

  Note: '추가 전용 보안 증적. 외부 AI 호출은 actor_type DELEGATED_AUTHORIZATION과 delegated_authorization_id로 위임 승인을 명시한다. 페이로드·오브젝트 증거에 자격증명, 비공개 전략 소스, 불필요한 보유 정보를 중복 저장하지 않는다.'

  Records (id, actor_type, actor_id, delegated_authorization_id, action_type, target_domain, target_id, reason_code, correlation_id, idempotency_key, before_hash, after_hash, evidence_object_id, occurred_at, recorded_at) {
    '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '00000000-0000-4000-8000-000000000001', null, 'REVIEW_EXAMPLE', 'review-example', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', '00000000-0000-4000-8000-000000000001', 'REVIEW_EXAMPLE', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa', '00000000-0000-4000-8000-000000000001', '2026-07-27T09:00:00+09:00', '2026-07-27T09:00:00+09:00'
  }
}

