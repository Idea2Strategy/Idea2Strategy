* text=auto eol=lf

# Unix, macOS, Docker, and cross-platform PowerShell use LF.
*.sh text eol=lf
*.ps1 text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Native Windows command scripts keep Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Local data is ignored, but keep binary formats safe if fixtures are ever added.
*.dump binary
*.pgdump binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Preserve assembler-produced CI migration bytes so manifest hashes are portable.
db/flyway-ci-bundle/*.sql -text
db/flyway-ci-bundle/*.fixture -text
