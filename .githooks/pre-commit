#!/bin/sh
# Repository-wide guards that apply regardless of editor or agent.

root="$(git rev-parse --show-toplevel)"
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)"
fail=0

case "$branch" in
    develop|main)
        echo "pre-commit: direct commits to '$branch' are not allowed; use a work branch." >&2
        fail=1
        ;;
esac

if [ -f "$root/db/flyway-ci-bundle/source-revisions.json" ]; then
    moved=''
    for path in backend backtest-engine trading-engine data-pipeline; do
        if git diff --cached --name-only -- "$path" | grep -q .; then
            moved="$moved $path"
        fi
    done
    if [ -n "$moved" ] && ! git diff --cached --name-only -- db/flyway-ci-bundle | grep -q .; then
        echo "pre-commit: moved gitlinks ($moved ) require a refreshed db/flyway-ci-bundle." >&2
        fail=1
    fi
fi

offenders=$(git diff --cached -U0 | grep '^+' | grep -oE '\b(test|live)_[0-9a-z_]{35}\b' | sort -u)
if [ -n "$offenders" ]; then
    echo "pre-commit: identifiers matching a verified-secret detector were added:" >&2
    echo "$offenders" | sed 's/^/  /' >&2
    fail=1
fi

generic_password_assignments=$(git diff --cached -U0 -- '*.ps1' | grep '^+' | grep -Ei '\$[a-z0-9_]*password[[:space:]]*=.*Get-EnvValue.*PASSWORD' || true)
if [ -n "$generic_password_assignments" ]; then
    echo "pre-commit: a GitGuardian Generic Password detector trigger was added:" >&2
    echo "$generic_password_assignments" | sed 's/^/  /' >&2
    echo "  Use a credential-named local variable for environment reads." >&2
    fail=1
fi

exit $fail
