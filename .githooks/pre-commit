#!/bin/sh
# 도구와 무관한 가드. Claude Code 훅은 Claude 세션에만 걸리고 Codex 세션에는 걸리지
# 않으므로, 실제로 사고가 났던 규칙은 git 쪽에 둔다. 여기 있는 것은 사람이 기억하지
# 않아도 지켜진다.
#
# 설치: scripts/install-git-hooks.ps1 (initialize-local-harness.ps1 이 호출한다)
# 우회: git commit --no-verify — 정말 그래야 할 때만 쓰고 왜 그랬는지 남긴다.

root="$(git rev-parse --show-toplevel)"
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)"
fail=0

# ---------------------------------------------------------------- 1. 통합 브랜치 보호
# develop 과 main 에 직접 커밋하면 다른 세션이 같은 체크아웃에서 브랜치를 빼앗는다.
# 이 프로젝트에서 실제로 반복된 사고다.
case "$branch" in
    develop|main)
        echo "pre-commit: '$branch' 에 직접 커밋할 수 없다." >&2
        echo "  작업 브랜치를 만든다:  git switch -c feature/<이슈>-<이름>" >&2
        echo "  동시 세션이 있으면 워크트리를 쓴다:  git worktree add ../worktrees/<이름> $branch" >&2
        fail=1
        ;;
esac

# ---------------------------------------------------------------- 2. Flyway 번들 동반 규칙
# 서브모듈 gitlink 가 움직이는 커밋은 같은 커밋에서 db/flyway-ci-bundle 을 갱신해야
# 한다. 안 하면 루트 CI 의 flyway-integration 이 깨진다. 2분 기다린 뒤 알게 되는 대신
# 지금 알려준다.
if [ -f "$root/db/flyway-ci-bundle/source-revisions.json" ]; then
    moved=''
    for path in backend backtest-engine trading-engine data-pipeline; do
        if git diff --cached --name-only -- "$path" | grep -q .; then
            moved="$moved $path"
        fi
    done
    if [ -n "$moved" ]; then
        if ! git diff --cached --name-only -- db/flyway-ci-bundle | grep -q .; then
            echo "pre-commit: gitlink 가 움직였는데($moved ) db/flyway-ci-bundle 이 이 커밋에 없다." >&2
            echo "  gitlink 를 먼저 커밋한 뒤 실행한다:  pwsh scripts/refresh-flyway-ci-bundle.ps1" >&2
            echo "  그리고 db/flyway-ci-bundle 을 같은 커밋에 넣는다(--amend)." >&2
            fail=1
        fi
    fi
fi

# ---------------------------------------------------------------- 3. 비밀 스캐너 오탐 예방
# TruffleHog 의 Lob 탐지기는 test_ 뒤에 [a-z0-9_] 가 정확히 35자면 매칭하고 그것을
# verified 로 보고한다. 자격증명이 하나도 없는 diff 에서 gate7 이 깨진다. 길이만이
# 트리거이므로 여기서 미리 잡는다.
offenders=$(git diff --cached -U0 | grep '^+' | grep -oE '\b(test|live)_[0-9a-z_]{35}\b' | sort -u)
if [ -n "$offenders" ]; then
    echo "pre-commit: 비밀 스캐너(gate7)가 오탐할 식별자가 있다:" >&2
    echo "$offenders" | sed 's/^/  /' >&2
    echo "  test_ 뒤가 정확히 35자면 TruffleHog 이 Lob 키로 오인한다. 이름 길이를 바꾼다." >&2
    echo "  키를 찾거나 rotate 하지 말 것 — 자격증명 문제가 아니다." >&2
    fail=1
fi

exit $fail
